//----------------------------------------------------------------------------------------------
// Data Pad : Weapons Screen
// 
//----------------------------------------------------------------------------------------------
{

	menuDef 
	{
		name					"datapadWeaponsMenu"
		fullScreen				1							// MENU_TRUE				
		rect					0 0 640 480						// Size and position of the menu
		visible					1							// Visible on open
		focusColor				1 1 1 1						// Focus color for text and items

	onESC 
		{ 
				play			"sound/interface/esc.wav" 					
				uiScript		closedatapad					// Close menu				
		}
	onOpen
		{ 
				uiScript		nextDataPadWeapon
		}

//----------------------------------------------------------------------------------------------
//	MENU BACKGROUND
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				background
			group				none
			rect				0 0 640 480
			style				WINDOW_STYLE_SHADER
			background			"menu/ground/padmenu"	
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		
//----------------------------------------------------------------------------------------------
//	MISSION TEXT
//----------------------------------------------------------------------------------------------

	itemDef 
		{
			name				weapons
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_OWNERDRAW
			textscale			1
			forecolor			.509 .609 .847 1
			visible				1
			ownerdraw			204					// UI_DATAPAD_WEAPONS
		}
	itemDef										
		{
			name				weapon1
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			forecolor			1 1 1 1
			visible				0
			decoration
		}	
//---------------------------------------------------------------------
//						LOWER BUTTONS MISSION
//---------------------------------------------------------------------
		itemDef 
		{
			name				moveslist_title_box
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 420 640	60
			backcolor			0 0 .6 1
			visible				1
			decoration
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS MISSION
//---------------------------------------------------------------------		
	itemDef 
		{
			name				mission_box
			style				WINDOW_STYLE_SHADER
			rect				10 428 110 30
			background			"menu/box_redux"
			forecolor			1 1 1 1
			visible				1
			border				4
			decoration
		}
	itemDef 
		{
			name				mission
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				10 430 110 30
			text				@MENUS_DP_MISSION
			descText			@MENUS_AN_OVERVIEW_OF_MISSION
			textstyle			3
			font				3
			textscale			1
			textalignx			55
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 .682 0 1
			visible				1
			mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		5 430 125 25
			}
			mouseExit 
			{ 
				hide			button_glow 
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ; 
				close			all ; 
				open			datapadMissionMenu 
			}
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS WEAPONS
//---------------------------------------------------------------------		
	itemDef 
		{
			name				weapons_box
			style				WINDOW_STYLE_SHADER
