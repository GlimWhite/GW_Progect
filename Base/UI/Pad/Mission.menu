//----------------------------------------------------------------------------------------------
// Data Pad : Mission Objectives Screen
// 
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"datapadMissionMenu"
		fullScreen				1								// MENU_TRUE				
		rect					0 0 640 480						// Size and position of the menu
		visible					1								// Visible on open
		focusColor				1 1 1 1							// Focus color for text and items
	onESC 
		{ 
				play			"sound/interface/esc.wav" 					
				uiScript		closedatapad					// Close menu				
		}
//---------------------------------------------------------------------
//						BACKGROUND MENU
//---------------------------------------------------------------------
	itemDef 
		{
			name				background
			group				none
			rect				0 0 640 480
			style				WINDOW_STYLE_SHADER
			background			"menu/ground/padmenu"	
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//---------------------------------------------------------------------
//						TEXT MISSION
//---------------------------------------------------------------------
//Цель миссиии	
	itemDef 
		{
			name				mission
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_OWNERDRAW
			rect				20 20 0 0 				//This is set in the code
			font				3
			textstyle			3
			forecolor			.95 .64 .37 1
			textscale			1
			visible				1
			ownerdraw			203						// UI_DATAPAD_MISSION
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS MISSION
//---------------------------------------------------------------------
		itemDef 
		{
			name				moveslist_title_box
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 420 640	60
			backcolor			0 0 .6 1
			visible				1
			decoration
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS MISSION
//---------------------------------------------------------------------		
	itemDef 
		{
			name				mission_box
			style				WINDOW_STYLE_SHADER
			rect				10 428 110 30
			background			"menu/box_redux"
			forecolor			1 1 1 1
			visible				1
			border				4
			decoration
		}
	itemDef 
		{
			name				mission
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				10 430 110 30
			text				@MENUS_DP_MISSION
			descText			@MENUS_AN_OVERVIEW_OF_MISSION
			textstyle			3
			font				3
			textscale			1
			textalignx			55
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		5 430 125 25
			}
		mouseExit 
			{ 
				hide			button_glow 
			}
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS WEAPONS
//---------------------------------------------------------------------		
	itemDef 
		{
			name				weapons_box
			style				WINDOW_STYLE_SHADER
			rect				130 428 110 30
			background			"menu/box_redux"
			forecolor			1 1 1 1
			visible				1
			border				4
			decoration
		}
	itemDef 
		{
			name				weapons
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				130 430 110 30
			text				@MENUS_WEAPONS
			descText			@MENUS_VIEW_CURRENTLY_OWNED
			textstyle			3
			font				3
			textscale			1
			textalignx			55
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 .682 0 1
			visible				1
			mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		125 430 125 30
			}
			mouseExit 
			{ 
				hide			button_glow 
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ; 
				close			all ; 
				open			datapadWeaponsMenu 
			}
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS FORSE
//---------------------------------------------------------------------		
	itemDef 
		{
			name				force_box
			style				WINDOW_STYLE_SHADER
			rect				250 428 110 30
			background			"menu/box_redux"
			forecolor			1 1 1 1
			visible				1
			border				4
			decoration
		}
	itemDef 
		{
			name				force
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				250 430 110 30
			text				@MENUS_DP_FORCE
			descText			@MENUS_VIEW_CURRENT_FORCE_POWERS
			textstyle			3
			font				3
			textscale			1
			textalignx			55
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 .682 0 1
			visible				1
			
		mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		245 430 125 30
			}
		mouseExit 
			{ 
				hide			button_glow 
			}	  	  
		action 
			{ 
				play			"sound/interface/button1.wav" ; 
				close			all ; 
				open			datapadForcePowersMenu 
			}
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS FORSE
//---------------------------------------------------------------------	
	itemDef 
		{
			name				moves_box
			style				WINDOW_STYLE_SHADER
			rect				370 428 110 30
			background			"menu/box_redux"
			forecolor			1 1 1 1
			visible				1
			border				4
			decoration
		}	
	itemDef 
		{
			name				moves
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				370 430 110 25
			text				@MENUS_MOVES
			descText			@MENUS_MOVES_DESC
			textstyle			3
			font				3
			textscale			1
			textalignx			55
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 .682 0 1
			visible				1
			
		mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		365 430 125 30
			}
		mouseExit 
			{ 
				hide			button_glow 
			}	  	  
		action 
			{ 
				play			"sound/interface/button1.wav" ; 
				close			all ; 
				open			datapadMovesMenu 
			}
		}
//---------------------------------------------------------------------
//						LOWER BUTTONS FORSE
//---------------------------------------------------------------------			
	itemDef 
		{
			name				exit_box
			style				WINDOW_STYLE_SHADER
			rect				490 428 138 30
			background			"menu/box_redux"
			forecolor			1 1 1 1
			visible				1
			border				4
			decoration
		}
	itemDef 
		{
			name				exit
			group				none
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				490 430 125 30
			text				@MENUS_RESUME
			descText			@MENUS_RETURN_TO_GAME
			textstyle			3
			font				3
			textscale			1
			textalignx			73
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 .682 0 1
			visible				1

			mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		485 430 150 30
			}
			mouseExit 
			{ 
				hide			button_glow 
			}	  	  
			
			action 
			{ 
				play			"sound/interface/button1.wav" ; 
				uiScript		closedatapad			// Close menu				
			}
		}
//------------------------------------------------------------------------
//								Рамка
//------------------------------------------------------------------------			
	itemDef 
		{
			name				galagramma
			group				none
			rect				0 0 640 420
			style				WINDOW_STYLE_SHADER
			background			"bordermenu"	
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				background
			group				none
			rect				0 0 640 480
			style				WINDOW_STYLE_SHADER
			background			"menu/ground/padmenu_wall"	
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//------------------------------------------------------------------------
//							ТИТУТУЛЬНЫЙ ТЕКСТ
//------------------------------------------------------------------------	
	itemDef 
		{
			name				complete_glow
			group				none
			rect				170 -3 300 30
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//Титульник "Планшет"
	itemDef
		{
			name				screen_title
			type				ITEM_TYPE_TEXT
			rect				170 -2 300 32
			text				@MENUS_DATAPADTITLE
			font				3
			textstyle			3
			forecolor			.95 .64 .37 1
			textscale			1
			textalign			ITEM_ALIGN_CENTER
			textalignx			150
			visible				1
			decoration
		}
	itemDef 
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_blendboxr"
			forecolor			1 1 1 1
			visible				0
			decoration
		}
	}	
}









