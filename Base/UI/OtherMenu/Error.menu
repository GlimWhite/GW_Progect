//----------------------------------------------------------------------------------------------
//	                                     МЕНЮ ОШИБОК В ИГРЕ
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"error_popmenu"
	   	visible					1
	   	fullscreen				1
		focusColor				1 1 1 1					   	
//		popup
//		outOfBoundsClick
	onClose 
		{ 
			uiScript			clearError 
		}
		
	onOpen 
		{ 
		}
		
	onESC 
		{ 
			close				error_popmenu ; 
			open				mainMenu 
		}
//----------------------------------------------------------------------------------------------
//	                                      ФОН МЕНЮ
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				groundmenu
			group				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"menu/ground/MenuGround"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//	                                     ОШИБКА
//----------------------------------------------------------------------------------------------	
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
	itemDef 
		{
			name				window
			rect				40 40 560 400
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			.988 .984 .121 1
			bordersize			5
			visible				1
			decoration
		}

		itemDef 
		{
			name				errorinfo
			rect				320 20 320 20	
			text 				@MENUS_ERROR
			textalign			ITEM_ALIGN_CENTER
			textstyle			6
			textscale			0.8
			font				5
			forecolor			.988 .984 .121 1
			visible				1
			decoration
		}
		
		itemDef 
		{
			name				errorinfo
			rect				50 50 530 330
			type				ITEM_TYPE_TEXT
			style				WINDOW_STYLE_FILLED
			textstyle			3
			autowrapped
			cvar 				"com_errorMessage"
			textalign			ITEM_ALIGN_LEFT
			textscale			1
			forecolor			1 1 1 1
			visible				1
			decoration
		}

//----------------------------------------------------------------------------------------------
//	                                    ПРИНЯТИЕ
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				260 415 140 30
			background			"menu/menu_buttonback"	
			visible				0
			decoration
		}
	itemDef 
		{
			name				exit
			group				grpControlbutton
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				300 420 120 30
			text				@MENUS_OKAY
			textalign			ITEM_ALIGN_LEFT
			font 				4
			textscale 			1.2
			forecolor			.95 .64 .37 1
			visible				1
					
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			error_popmenu  
				open			mainMenu 
			}
		mouseEnter 
			{ 
				show			button_glow 
			}
		mouseExit 
			{ 
				hide			button_glow 
			}	  	  
		}	
	}
}


