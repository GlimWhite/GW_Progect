//----------------------------------------------------------------------------------------------
// 									Load screen
//			Data displayed while level is loading. Run only during map transitions.
//	Данные отображаются во время загрузки уровня. Запускается только при переходе по карте
//---------------------------------------------------------------------------------------------- 
{
menuDef 
	{
		name					"loadscreen"
		fullScreen				0
		rect					0 0 640 480
		visible					1
	onOpen
		{
			close				deadloadMenu ;
		}
	onClose 
		{
			close				deadloadMenu ;
		}
//----------------------------------------------------------------------------------------
// 									ФОН
//----------------------------------------------------------------------------------------		
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/MenuLoad"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------
// 									Загрузка
//----------------------------------------------------------------------------------------
/*
// Picture that goes along with map
	itemDef 
		{
			name				loadgamepic
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480			
			ownerdraw			236					//UI_ALLMAPS_SELECTION		
			forecolor			1 1 1 1
			visible				1 
			decoration 
		}
		*/
//Текст миссии
	itemDef
		{
			name				briefingtexttop
			group				none
			style				WINDOW_STYLE_FILLED
			rect				15 100 605 250
			backcolor			.03 .12 0.8 0.5
			border				1
			bordercolor			.03 .12 0.8 0.8
			bordersize			2
			visible				1
		}
//----------------------------------------------------------------------------------------------
//   							ЗАТЕМНЕНЕНИЕ ФОНА
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
	itemDef
		{
			name				briefingtext
			group				none
			type				ITEM_TYPE_TEXTSCROLL
			rect				50 120 550 250
			cvar				ui_missionbriefing
			textalign			ITEM_ALIGN_CENTER
			font				5
			textstyle			1
			textscale			0.5
			forecolor			.95 .64 .37 1
			visible				1
			lineHeight			24
			autowrapped
		}
	itemDef 
		{
			name				loadtext
			style				WINDOW_STYLE_SHADER
			rect				200 10 220 30
			background			"LoadText"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				loadgroud
			style				WINDOW_STYLE_SHADER
			rect				110 445 420 25
			background			"LoadGround"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	}
}