//------------------------------------------------------------------------------------------------
// 											VIDEO WARNING
//				С РАБАТЫВАЕТ ЕСЛИ НЕ ПРИМЕНИТЬ ИЗМЕНЕНИЯ В ЗНАК НЕ ПОДВЕРЖДЕНИЕ ИЗМЕНЕНИЙ
//------------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"videowarningMenu"
		visible					0
		fullScreen				1						// MENU_TRUE
		focusColor				1 1 1 1					// Focus color for text and items
		outOfBoundsClick								// this closes the window if it gets a click out of the rectangle	
	popup								
	onESC 
		{ 
			play				"sound/interface/esc.wav" 		
			close				all
			open				setupMenu
		}
	onClose
		{
		}
//----------------------------------------------------------------------------------------------
//										MENU BACKGROUND
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"menu/ground/MenuGround"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//КРАСНЫЙ КВАДРАТ ПОД ТЕКСТ		
	itemDef 
		{
			name				warn_background
			group				vidwarn
			style				WINDOW_STYLE_SHADER
			rect				100 120 460 250
			background			"menu/menu_boxred"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
// БАРДЮР ДЛЯ СТРОКИ ВНЕСТИ ИЗМЕНЕНИЯ ГРАФИКА
	itemDef 
		{
			name				setup_border
			group				vidwarn
			style				WINDOW_STYLE_FILLED
			rect				98 118 461 249
			border				1
			bordersize			2
			bordercolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//											VIDEO WARNING
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				vidwarn_text1
			group				vidwarn
			text				@MENUS_YOU_HAVE_MADE_CHANGES
			rect				320 140 290 20
			textalign			ITEM_ALIGN_CENTER
			forecolor			.95 .64 .37 1
			font 				5
			textstyle			5
			textscale 			0.7
			visible				1
			decoration
		}
	itemDef 
		{
			name				vidwarn_text2
			group				vidwarn
			text				@MENUS_APPLY_THESE_CHANGES_OR
			rect				320 160 290 20
			textalign			ITEM_ALIGN_CENTER
			forecolor			.95 .64 .37 1
			font 				5
			textstyle			5
			textscale 			0.7	
			visible				1		
			decoration
		}
//ФОН ДЛЯ СЛОВА НЕТ
	itemDef 
		{
			name				default_no_button
			group				vidwarn
			style				WINDOW_STYLE_SHADER
			rect				403 300 100 25
			background			"menu/menu_top_mp"
			forecolor			.95 .64 .37 1
			border				1
			bordersize			1
			bordercolor			1 1 1 1
			visible				1
			decoration
		}
//ОТКАЗ ОТ ВНЕСЕНИЙ - ВОЗРАЩАЕТ В МЕНЮ
		itemDef 
		{
			name				vidwarn_no
			group				vidwarn
			text				@MENUS_DISCARD
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				415 300 140 25
			textalign			ITEM_ALIGN_LEFT
			font 				3
			textstyle			1
			textscale 			1
			forecolor			.95 .64 .37 1
			visible				1
		action 
			{ 
				play			"sound/interface/esc.wav" 		
				close			"videowarningMenu" ;
				setcvar			"ui_r_modified" 0 ;
				rundeferred ;
			}	  	  
		}
//ФОН ДЛЯ СЛОВА ДА
	itemDef 
		{
			name				default_yes_button
			group				vidwarn
			style				WINDOW_STYLE_SHADER
			rect				133 300 100 25
			background			"menu/menu_top_mp"
			forecolor			.95 .64 .37 1
			border				1
			bordersize			1
			bordercolor			1 1 1 1
			visible				1
			decoration
		}
//ПРИНЯТИЕ ИЗМЕНЕНИЙ
	itemDef 
		{
			name				vidwarn_yes
			group				vidwarn
			text				@MENUS_APPLY
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				145 300 140 25
			textalign			ITEM_ALIGN_LEFT
			font 				3
			textstyle			1
			textscale 			1
			forecolor			.95 .64 .37 1
			visible				1
		action 
			{ 
				play			"sound/interface/button1.wav" ; 

				uiScript		updatevideosetup ;
				close			all
			}	  	  
		}
	}	
}






