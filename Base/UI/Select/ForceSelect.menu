//
//Меню выбора силы
//
// Игроку разрешается присвоить одно очко любой из заданных силовых способностей
//
//
// Не меняйте названия полей, которые заканчиваются на
// _hexpic 
// _fbutton 
// _level1desc
// _level2desc
// _level3desc
//
// Также не изменяйте 
// allocate_text
// выделенный текст
//
//
// В uiScript initallocforcepower задается ранговый фон для силы силы
//
// В uiScript showforceleveldesc отображается описание соответствующего уровня для этой силы.
//
// uiScript affectforcepowerlevel повышает ранг силы. Оно 
// также отображает значки серым цветом или без него.
//
{				   
	menuDef 
	{
		name					"ForceSelect"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					438
		descScale				1
		desctextstyle			5
		desccolor				1 0.2 0.2 1
		descAlignment			ITEM_ALIGN_CENTER	
	onOpen 
		{
		// Update force power pics to current force power levels
		// Light powers
			uiScript  			"initallocforcepower" "absorb"
			uiScript  			"initallocforcepower" "heal"
			uiScript  			"initallocforcepower" "mindtrick"
			uiScript  			"initallocforcepower" "protect"

		// Core powers
			uiScript  			"initallocforcepower" "jump"
			uiScript  			"initallocforcepower" "pull"
			uiScript  			"initallocforcepower" "push"
			uiScript  			"initallocforcepower" "sense"
			uiScript  			"initallocforcepower" "speed"
			uiScript  			"initallocforcepower" "sabdef"
			uiScript  			"initallocforcepower" "saboff"
			uiScript  			"initallocforcepower" "sabthrow"
			
		// Dark powers
			uiScript  			"initallocforcepower" "drain"
			uiScript  			"initallocforcepower" "grip"
			uiScript  			"initallocforcepower" "lightning"
			uiScript  			"initallocforcepower" "rage"
			
			uiScript  			"forcehelpactive" 
			hide				sidebutton_glow_red
			close				ingameForceHelp
			stopVoice	
		}
	onESC 
		{ 
			play				"sound/interface/menuroam.wav" //CLOSE 				ALL
		}
//----------------------------------------------------------------------------------------------
//								MENU BACKGROUND
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/selectforce"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//								SCANLINES
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				scan
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 640
			background			"menu/scanlines"
			forecolor			0.5 0.5 0.5 0.1
			visible				1
			decoration
		}
	itemDef 
		{
			name				sidebutton_glow_red
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendboxr"
			forecolor			1 1 1 1
			decoration
		}
//Glow title text 
	itemDef 
		{
			name				titleGlow
			group				none
			rect				120 0 420 28
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//							TEXT - Описание силы
//----------------------------------------------------------------------------------------------
//Текст: "Выбирите Навык Силы"
		itemDef
		{
			name				allocate_text
			type				ITEM_TYPE_TEXT
			rect				0 2 620 22
			text				@MENUS_ALLOCATE_FP
			textstyle			3
			font				3
			textscale			1.2
			textaligny			-5
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_CENTER
			textalignx			320
			visible				1
			decoration
		}
//Текст: "Новый навык выбран"
		itemDef
		{
			name				allocated_text
			type				ITEM_TYPE_TEXT
			rect				0 2 640 18
			text				@MENUS_ALLOCATED_FP
			textstyle			3
			font				3
			textscale			1.2
			textaligny			-5
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_CENTER
			textalignx			320
			visible				0
			decoration
		}
// Core Power message
		itemDef
		{
			name				allocated_text_core
			type				ITEM_TYPE_TEXT
			rect				0 5 640 18
			text				@MENUS_COREPOWER_DESC
			textstyle			3
			font				3
			textscale			1
			textaligny			-5
			forecolor			1 0 0 1 // .95 .64 .37 1
			textalign			ITEM_ALIGN_CENTER
			textalignx			320
			visible				0
			decoration
		}
//----------------------------------------------------------------------------------------------
//								So these will precache
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				precache
			group				none
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_1"
			forecolor			.65 .65 .65 1
			visible				0
			decoration
		}
		itemDef 
		{
			name				precache
			group				none
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_2"
			forecolor			.65 .65 .65 1
			visible				0
			decoration
		}
		itemDef 
		{
			name				precache
			group				none
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_3"
			forecolor			.65 .65 .65 1
			visible				0
			decoration
		}
		itemDef 
		{
			name				precache
			group				none
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_1_gold"
			forecolor			.65 .65 .65 1
			visible				0
			decoration
		}
		itemDef 
		{
			name				precache
			group				none
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_2_gold"
			forecolor			.65 .65 .65 1
			visible				0
			decoration
		}
		itemDef 
		{
			name				precache
			group				none
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_3_gold"
			forecolor			.65 .65 .65 1
			visible				0
			decoration
		}
	itemDef 
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			visible				0
			decoration
		}
		
//----------------------------------------------------------------------------------------------
//	DEALLOCATION BUTTON - this button is hidden until a power is chosen then this
//				becomes active so the power can be deallocated
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				deallocate_fbutton
			group				none
			type				ITEM_TYPE_BUTTON
			rect				0 0 0 0
			forecolor			0 0 1 1
			visible				0
		// Decrement force power
		action
			{
				// Hide all force level descrptions and have script determine the level of this one			
				uiScript		"decrementcurrentforcepower"
 				
				hide			deallocate_fbutton
				hide			leveltext
				
				show			force_button
				show			force_icon
				show			force_desc
			}
		}	
//---------------------------------------------------------------------------------------------
//	ABSORB BUTTONS AND BUTTON GRAPHICS
//----------------------------------------------------------------------------------------------
// The hex powerlevel graphic (this has to print first because it's additive)
	itemDef 
		{
			name				absorb_hexpic
			group				hexpic
			style				WINDOW_STYLE_SHADER
			rect				76 31 70 49
			background			"menu/hex/hex_pattern_0"
			forecolor			1 1 1 1
			visible				1
			decoration
		}	
	itemDef
		{
			name				absorb_iconpic
			group				iconpic
			style				WINDOW_STYLE_SHADER
			rect				28 31 49 49
			background			"light_absorb"
			forecolor			.65 .65 .65 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				absorb_fbutton
			group				force_button
			type				ITEM_TYPE_BUTTON
			rect				33 41 115 46
			forecolor			1 1 1 1
			visible				1
			desctext			@MENUS_ADDFP
// Show force power description
		mouseEnter 
			{ 
				setitemcolor		absorb_iconpic  forecolor 1 1 1 1
				setitemcolor		absorb_hexpic  forecolor  1 1 1 1				

				show				force_icon
				show				force_desc
			}			
		mouseExit 
			{ 
				setitemcolor		absorb_iconpic  forecolor 1 1 1 1
				setitemcolor		absorb_hexpic  forecolor  1 1 1 1
			}
// Because this gets focus when the menu first opens.
		onFocus	
			{
				setitemcolor		absorb_iconpic  forecolor 1 1 1 1
				setitemcolor		absorb_hexpic  forecolor  1 1 1 1	
// Hide all force level descrptions and have script determine the level of this one
				hide				leveltext
				uiScript  			"showforceleveldesc" "absorb"
				
				setitembackground	force_icon	"light_absorb"	
				setitemtext			force_desc	@SP_INGAME_FORCE_ABSORB_DESC
			}
		// Increment force power
	action
			{	// hide descriptions and let affectforcepowerlevel determine the corect one
				hide				leveltext
				uiScript			"affectforcepowerlevel" "absorb"
				hide				force_button
				
				setitemrect			deallocate_fbutton	33 31 115 46
				show				deallocate_fbutton
				
				setitemcolor		absorb_iconpic  forecolor 1 1 1 1
				setitemcolor		absorb_hexpic  forecolor  1 1 1 1				
			}
		}
//----------------------------------------------------------------------------------------------
//	HEAL BUTTONS AND BUTTON GRAPHICS
