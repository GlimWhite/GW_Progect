// Hide all force level descrptions and have script determine the level of this one
				hide				leveltext
				uiScript  			"showforceleveldesc" "heal"
				
				setitembackground	force_icon	"light_heal"
				setitemtext			force_desc	@SP_INGAME_FORCE_HEAL_DESC				

				show				force_icon
				show				force_desc
			}
