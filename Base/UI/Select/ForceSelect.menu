//----------------------------------------------------------------------------------------------
//							BOTTOM ROW OF BUTTONS
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name					sidebutton_glow
			group					none
			style					WINDOW_STYLE_SHADER
			background				"menu/menu_buttonback"
			forecolor				1 1 1 1
			decoration
		}
	itemDef
		{
			name					backbut
			type					ITEM_TYPE_BUTTON
			rect					40 455 140 24
			forecolor				.95 .64 .37 1
			text					@MENUS_HELP
			textstyle				3
			font					3
			textscale				1
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textaligny				-1
			desctext				@MENUS_HELP_DESC1
			visible					1
		mouseEnter 
			{ 
				show				sidebutton_glow
				setitemrect			sidebutton_glow				0 455 150 28
			}
		mouseExit 
			{ 
				hide				sidebutton_glow
			}
// If we're backing up then we have to reset levels to what they were
			action
			{
				play				"sound/interface/menuroam.wav"
				open				ingameForceHelp
				show				sidebutton_glow_red
				setitemrect			sidebutton_glow_red			0 455 150 28
				hide				sidebutton_glow
			}
		}
	itemDef
		{
			name				weaponbutton
			type				ITEM_TYPE_BUTTON
			rect				540 455 140 24
			text				@MENUS_WEAPONS
			forecolor			.95 .64 .37 1
			textstyle			3
			font				3
			textscale			1
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			-1
			desctext			@MENUS_CHOOSEWEAPONS
			visible				1
		mouseEnter 
			{ 
				show				sidebutton_glow
				setitemrect			sidebutton_glow				490 455 150 28
			}
		mouseExit 
			{ 
				hide				sidebutton_glow
			}
		action
			{
				play			"sound/interface/menuroam.wav"
				close			all
				open			ingameWpnSelect
			}
		}	
	}
}










