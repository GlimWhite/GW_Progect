//----------------------------------------------------------------------------------------
//  							TIER 1 MISSION BUTTONS
//----------------------------------------------------------------------------------------
//Миссия 1: "Спасательная операция - Нар'Крид"	
	itemDef
		{
			name				miss1
			group				mission_button
			type				ITEM_TYPE_BUTTON
			rect				0 50 200 20
			text				@MENUS_T2_RANCOR_TITLE
			textalign			ITEM_ALIGN_LEFT
			font				5
			textstyle			5
			textscale			0.5
			forecolor			.95 .64 .37 1
			textalignx			21
			visible				1
			
			cvartest			"tiers_complete"
			disablecvar		
			{
				"t2_rancor"
			}
			cvarSubString
		mouseEnter 
			{ 
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red			-20 43 330 24		
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action
			{
				play			"sound/weapons/force/protect.wav" 
				
				show			planet_name
				setitemtext		planet_name		@MENUS_NAR_KREETA
				
				show			briefing_text
				setitemtext		briefing_text 	@BRIEFINGS_T2_RANCOR
				
				transition		briefing_text	 18 27 300   0  18 27 300 384 15 15
				
				show			backbut
				show			accbut1
				show			top_planets
				
				show			krildor
				hide			zonju
				hide			dosuun
				hide			narkreeta
				hide			coruscant

				transition		planet_name		800  7 100  30 340  7 100  30 15 15
				transition		top_planets		800  0 306 474 314  0 306 474 15 15
				transition		decplanet		800  0 304 474 314  0 304 474 15 15
				transition		planet			800 80 300 300 325 80 300 300 15 15
				
				hide			mission_button					
				hide			sidebutton_glow
				hide			sidebutton_glow_red
				hide			ExitGame
			}
		}
