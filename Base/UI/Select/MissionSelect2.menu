//------------------------------------------------------------------------------------------------
// 								Mission Select 2 Menu
//						Select missions from the 2nd tier.
//------------------------------------------------------------------------------------------------
{					   
	menuDef 
	{
		name					"ingameMissionSelect2"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
		focusColor				1 1 1 1
	
		descAlignment			ITEM_ALIGN_CENTER	
		disablecolor			.5 .5 .5 1
		
		fadeClamp				1.0						// sets the fadeup alpha
		fadeCycle				25						// how often fade happens in milliseconds
		fadeAmount				0.05					// amount to adjust alpha per cycle	
	onOpen 
		{
		stopVoice
		
			show				mission_button
			show				map_title
			show				ExitGame
			
			hide				planet_name
			hide				briefing_text
			hide				backbut
			hide				accbuttons
			hide				planet
			hide				top_planets
			
			transition			mission_dec		-600   2 305 413 11   2 305 413 15 15
			transition			top_mission		-600   0 304 415 10   0 304 415 15 15
			transition			miss1			-600  50 200  20  0  50 200  20 15 15
			transition			miss2			-600  80 200  20  0  80 200  20 15 15
			transition			miss3			-600 110 200  20  0 110 200  20 15 15
			transition			miss4			-600 140 200  20  0 140 200  20 15 15
			transition			miss5			-600 170 200  20  0 170 200  20 15 15
			transition			ExitGame		-600 414 303  59 11 414 303  59 15 15
		}	
		
	onESC 
		{ 
			Open				mainMenu
			close				ingameMissionSelect2
		}
//----------------------------------------------------------------------------------------
//	                                      ФОН МЕНЮ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"missionselect"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//Детали для меню
	itemDef 
		{
			name				mission_dec			
			group				none
			style				WINDOW_STYLE_SHADER
			rect				11 2 305 413	
			background			"mission_dec"
			forecolor			1 1 1 1
			visible				1
			decoration
		}	
//Выделение квадратное под меню миссий
	itemDef 
		{
			name				top_mission
			group				none
			style				WINDOW_STYLE_SHADER
			rect				10 0 304 415	
			background			"menu/menu_top_mp_new"
			forecolor			0.2 0.1 0.8 1
			visible				1
			border				1
			bordercolor			0 0 0 1
			bordersize			1
			decoration
		}
//----------------------------------------------------------------------------------------
//	                                    ВЫДЕЛЕНИЕ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				sidebutton_glow
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			decoration
		}
	itemDef 
		{
			name				sidebutton_glow_red
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendboxr"
			forecolor			1 1 1 1
			decoration
		}
//----------------------------------------------------------------------------------------
//	                              ТЕКСТ ЗАДАНИЯ
//----------------------------------------------------------------------------------------
	itemDef
		{
			name				briefing_text
			type				ITEM_TYPE_TEXTSCROLL
			text				@BRIEFINGS_T1_SOUR
			textstyle			3
			font				3
			forecolor			1 1 1 1
			textscale			1
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			-1
			lineHeight			20
			visible				0
			autowrapped
		}
//----------------------------------------------------------------------------------------
//	                   		 КНОПКА ВЫХОД В МЕНЮ
//----------------------------------------------------------------------------------------
	itemDef
		{
			name				ExitGame
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			text				@MENUS_EXIT
			textstyle			3
			font				3
			textscale			1.2
			textalign			ITEM_ALIGN_LEFT
			textalignx			117
			textaligny			12
			
			background			"menu/menu_top_mp_new"
			forecolor			1 1 1 1
			border				1
			bordercolor			0 0 0 1
			bordersize			1
			
		mouseEnter 
			{ 
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red		11 415 303 59
				setitemrect		ExitGame				12 416 302 57
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
				setitemrect		ExitGame				11 415 303 59
			}
		action
			{
				play			"sound/interface/esc.wav" 								
				close			all
				open			mainMenu
			}
		}
//----------------------------------------------------------------------------------------
//					GENERAL BACK BUTTON - if you don't want this mission		
//----------------------------------------------------------------------------------------
	itemDef
		{
			name				backbut
			group				accbuttons
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				11 414 154 60
			text				@MENUS_BACK_CAPS
			textstyle			3
			font				3
			textscale			1
			textalign			ITEM_ALIGN_LEFT
			textalignx			47
			textaligny			15
			
			background			"menu/menu_top_mp_new"
			forecolor			1 1 1 1
			border				1
			bordercolor			0 0 0 1
			
		mouseEnter 
			{ 
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red		11 415 150 60
				setitemrect		backbut					12 416 150 58
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
				setitemrect		backbut					11 414 154 60
			}
		action
			{
				play			"sound/interface/esc.wav" 								

				show			mission_button
				show			ExitGame
				
				hide			accbuttons
				hide 			briefing_text			
				hide			backbut
							
				hide			planet_name								
				hide			sidebutton_glow
				hide			sidebutton_glow_red
				hide			top_planets
				
			transition			planet_name		 340   7 100  30 800   7 100  30 15 15
			transition			top_planets		 314   0 306 474 800   0 306 474 15 15
			transition			decplanet		 314   0 304 474 800   0 304 474 15 15
			transition			planet			 325  80 300 300 800  80 300 300 15 15
				
			transition			miss1			-600  50 200  20   0  50 200  20 15 15
			transition			miss2			-600  80 200  20   0  80 200  20 15 15
			transition			miss3			-600 110 200  20   0 110 200  20 15 15
			transition			miss4			-600 140 200  20   0 140 200  20 15 15
			transition			miss5			-600 170 200  20   0 170 200  20 15 15
			}
		}
//----------------------------------------------------------------------------------------
// ACCEPT BUTTONS - IF YOU CHOOSE A PARTICULAR MISSION
//----------------------------------------------------------------------------------------
//Принятие 1 задания в игре	
	itemDef
		{
			name				accbut1
			group				accbuttons
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				163 414 151 60
			text				@MENUS_ACCEPT
			textstyle			3
			font				3
			textscale			1
			textalign			ITEM_ALIGN_LEFT
			textalignx			47
			textaligny			15
			
			background			"menu/menu_top_mp_new"
			forecolor			1 1 1 1
			border				1
			bordercolor			0 0 0 1
		mouseEnter 
			{ 
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red		164 415 148 58
				setitemrect		accbut1					164 416 148 58
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
				setitemrect		accbut1					163 414 151 60
			}
		action
			{
				playVoice		"sound/chars/kyle/07kyk001.mp3"
				show			kyle
				show			nextscreen_button
				show			accept1text
				
				setfocus		nextscreen_button
				setcvar 		tier_mapname "maptransition t1_sour"
								
				hide			backbut
				hide			briefing_text
				hide 			accbuttons				
				hide			sidebutton_glow
				hide			sidebutton_glow_red
				hide			ExitGame
			}
		}
