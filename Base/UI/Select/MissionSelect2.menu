				hide			dosuun
				hide			narkreeta
				hide			coruscant				
				
				transition		planet_name		800  7 100  30 340  7 100  30 15 15
				transition		top_planets		800  0 306 474 314  0 306 474 15 15
				transition		decplanet		800  0 304 474 314  0 304 474 15 15
				transition		planet			800 80 300 300 325 80 300 300 15 15
				
				transition		briefing_text	 14 27 300   0  14 27 300 384 15 15
				
				hide			sidebutton_glow
				hide			sidebutton_glow_red
				hide			mission_button	
				hide			ExitGame	
			}
		}
