//-----------------------------------------
// Go to Academy (taken from ingameMissionSelect)
//----------------------------------------
	itemDef
		{
			name				continue_stats
			group				stats
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				230 140 200 30
			text				@MENUS_CONTINUE
			textstyle			3
			font				3
			textscale			1			
			textalignx			53
			textaligny			0
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
			cvartest			"tier_storyinfo"
			showCvar			{ "5"; "6" }
		mouseEnter 
			{ 
				show			glow
				setitemrect		glow	222	160	218	30
			}
		mouseExit 
			{ 
				hide			glow
			}			
		action
			{
				close			all
				uiScript		startmap academy2
			}
		}

