//----------------------------------------------------------------------------------------------
// Force Status Menu
//
// The screen where after calculating the amount of light side force powers you allocated,
// Luke or Kyle will congratulate or warn you, depending on which way you're going.
//
//	90 % - 100 : very light
//	60 % - 89  : semi-light
//    41 % - 59  : neutral
//    11 % - 40  : semi-dark
//    0%   - 10  : very dark
//
//----------------------------------------------------------------------------------------------
{			   
	menuDef 
	{
		name					"ingameForceStatus"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
	onOpen 
		{
		// Compare light/dark force powers allocated
			uiScript			"calcforcestatus"

			uiScript	  		"initallocforcepower" "absorb"
			uiScript  			"initallocforcepower" "heal"
			uiScript  			"initallocforcepower" "mindtrick"
			uiScript  			"initallocforcepower" "protect"

			uiScript  			"initallocforcepower" "drain"
			uiScript  			"initallocforcepower" "grip"
			uiScript  			"initallocforcepower" "lightning"
			uiScript  			"initallocforcepower" "rage"
		}							
	onESC 
		{ 
			close				all
		}
//----------------------------------------------------------------------------------------------
//	MENU BACKGROUND
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/forcestatus"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				glow
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			decoration
		}
// Текущие распределение силы
	itemDef 
		{
			name				top_models
			group				none
			style				WINDOW_STYLE_SHADER
			rect				160 -5 340 30
			background			"menu/menu_buttonback"
			visible				1
			decoration
		}
	itemDef
		{
			name				allocate_text
			type				ITEM_TYPE_TEXT
			rect				0 0 340 18
			text				@MENUS_CUR_FORCE_ALLOC
			textstyle			3
			font				3
			textscale			1
			textalignx			220
			textaligny			-5
			forecolor			.95 .64 .37 1
			visible				1
			decoration
		}
