//----------------------------------------------------------------------------------------------
//	MODELS FOR V-O
//----------------------------------------------------------------------------------------------
	itemDef
		{
			name				luke_face
			group				models
			type 				ITEM_TYPE_MODEL
			rect				155 150 350 340
			model_g2anim 		"BOTH_STAND1_TALK2"
			model_g2skin		"models/players/luke/model_menu.skin"
			asset_model			"models/players/luke/model.glm"
			model_angle			180
			model_g2mins		13 -20 15
			model_g2maxs		60  20 55
			model_rotation		0
			model_fovx			10
			model_fovy			10
			isCharacter			1
			visible				1
			cvarTest			ui_forcestatus
			showCvar			{ "vll"; "sll"; "ntl"; "sdl"; "vdl"  }
			
			decoration

		}
	itemDef
		{
			name				kyle_face
			group				models
			type 				ITEM_TYPE_MODEL
			rect				155 150 350 340
			model_g2anim 		"BOTH_STAND1_TALK2"
