//_______________________________________________________________________________________________
//
// 										MISSION FAILED MENU
//								Displays choices after player death
//_______________________________________________________________________________________________
{
	menuDef 
	{
		name					"missionfailed_menu"
	   	visible					0
	   	fullscreen				0
	   	rect					0 0 640 480
		focusColor				1 1 1 1					   			
		style					WINDOW_STYLE_FILLED

		fadeClamp				1
		fadeCycle				50
		fadeAmount				0.1
		ignoreescape			1		
	onOpen 
		{ 
			play				"music/death_music"
			setcvar				ui_missionfailed	"0"
			
			transition			missionselect		170	100 280 0   170 100 280 30  25 25
			transition			loadquick			170 140 280 0 	170 140 280 30 	25 25
			transition			loadpoint			170 180 280 0 	170 180 280 30 	25 25
			transition			loadsave			170 220 280 0 	170 220 280 30 	25 25
			transition			leavemain			170	260 280 0   170 260 280 30  25 25	

			transition			text_failed			180 300   0 0	180 300 260 30	30 30 		
			transition			failed				180  50   0 0	180  40 260 30	30 30 
			
			transition			black_ground		320 240 1 1 -320 -240 1280 960 45 45				
		
			setitemcolor		loadquick			forecolor		1 1 1 0
			setitemcolor		loadpoint			forecolor		1 1 1 0
			setitemcolor		loadsave			forecolor		1 1 1 0		
			setitemcolor		text_failed			forecolor		1 0.2 0.2 0
			setitemcolor		failed				forecolor		1 0.2 0.2 0
			setitemcolor		leavemain			forecolor		1 1 1 0
			setitemcolor		missionselect		forecolor		1 1 1 0
				
			fadein				loadquick
			fadein				loadpoint
			fadein				loadsave
			fadein				leavemain
			fadein				text_failed
			fadein				failed
			fadein				missionselect
		}
	onEsc
		{
			play				"sound/interface/esc.wav"
			open				deadloadMenu
		}
	Onclose { }
//_______________________________________________________________________________________________
//
//										ОСНОВНОЕ МЕНЮ
//_______________________________________________________________________________________________
//*********************
// Затемнения фона
//*********************	
	itemDef 
		{
			name				black_ground
			style 				WINDOW_STYLE_SHADER
			background			"iris_mono"
			forecolor			0 0 0 0.5 
			visible				1
			decoration
		}
//**********************************
// Текст "Задание провалено сверху"
//**********************************			
	itemDef 
		{
			name				failed
			text				@SP_INGAME_MISSIONFAILED
			font				3
			textscale			1.1
			textalign			ITEM_ALIGN_CENTER		
			textalignx			140
			textaligny			5
			forecolor			1 0.2 0.2 0.5
			visible				1 
			decoration 
		}
//*********************************
// Текст "Задание провалено снизу"
//*********************************
	itemDef 
		{
			name				text_failed
			cvar				ui_missionfailed_text
			font				3
			textscale			1
			textalign			ITEM_ALIGN_CENTER		
			textalignx			130
			textaligny			5
			forecolor			1 0.2 0.2 0.5
			visible				1 
			decoration 
		}	
//_______________________________________________________________________________________________
//
//										КНОПКИ В МЕНЮ
//_______________________________________________________________________________________________		
//***************************
// Быстрая загрузка
//***************************	
	itemDef 
		{
			name				loadquick
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			text				@MENUS_INSTANT_LOAD_CAPS
			textalign			ITEM_ALIGN_LEFT	
			font				5
			textscale			0.5		
			textalignx			70
			textaligny			4
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			all
				uiScript  		"load_quick"						
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 140 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//***************************
// Кнопка "Контрольная точка"
//***************************	
	itemDef 
		{
			name				loadpoint
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				180 160 260 30
			text				@MENUS_LOAD_AUTOSAVE
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5	
			textalignx			15
			textaligny			4
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			all
				uiScript  		"load_auto"				// Perform screen init				
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 180 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//***************************
// Кнопка "Загрузить сохранения"
//***************************		
	itemDef 
		{
			name				loadsave
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				180 200 260 30
			text				@MENUS_LOAD_SAVE_GAME
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5	
			textalignx			50
			textaligny			4
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			all
				setcvar			cl_paused				"1"
				setcvar			ui_missionfailed		"1"
				open			DeadLoadMenu
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 220 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//***************************
// Кнопка "Выход в меню"
//***************************		
	itemDef 
		{
			name				leavemain
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			text				@MENUS_LEAVE_MAIN
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5	
			textalignx			80
			textaligny			4
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				uiScript		Quit
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 260 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//----------------------------------------------------------------------------------------
//	                              ВЫБОР МИССИИ
//----------------------------------------------------------------------------------------		
//Выбор 1 миссий
	itemDef 
		{
			name				missionselect
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				170 80 280 30
			text				@MENUS_NEW_MISSION
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			85
			textaligny			8

			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
			
			cvartest			"tier_storyinfo"
		showcvar
			{
				"1" "2" "3" "4" "5" "6"
			}			
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				setcvar			cl_paused		"1"
				uiScript		decrementforcepowerlevel
				close			all
				open			MissionSelect1					
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 100 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//Выбор миссии 2		
	itemDef 
		{
			name				missionselect
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				170 80 280 30
			text				@MENUS_NEW_MISSION
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			85
			textaligny			8

			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4

			visible				1
			
			cvartest			"tier_storyinfo"
			showcvar
			{
				"7" "8" "9" "10" "11" "12"
			}			
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				setcvar			cl_paused		"1"
				uiScript		decrementforcepowerlevel
				close			all
				open			MissionSelect2
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow		170 100 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}	
//Выбор мисии 3
	itemDef 
		{
			name				missionselect
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				170 80 280 30
			text				@MENUS_NEW_MISSION
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			85
			textaligny			8
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
			
			cvartest			"tier_storyinfo"
			showcvar
			{
				"13" "14" "15" "16" "17" "18"
			}	

		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				setcvar			cl_paused		"1"
				uiScript		decrementforcepowerlevel
				close			all
				open			MissionSelect3				
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 100 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}	
//*********************
// Выделение текста
//*********************	
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			0.5 0.5 0.5 0.1
			visible				1
			decoration
		}		
	}
}