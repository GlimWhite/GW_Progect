//_______________________________________________________________________________________________
//
// 										MISSION FAILED MENU
//								Displays choices after player death
//_______________________________________________________________________________________________
{
	menuDef 
	{
		name					"missionfailed_menu"
	   	visible					0
	   	fullscreen				0
	   	rect					0 0 640 480
		focusColor				1 1 1 1					   			
		style					WINDOW_STYLE_FILLED

		fadeClamp				1
		fadeCycle				50
		fadeAmount				0.1
		ignoreescape			1		
	onOpen 
		{ 
			play				"music/death_music"
			setcvar				ui_missionfailed	"0"
			
			transition			loadquick			170 120 280 0 	170 120 280 30 	25 25
			transition			loadpoint			170 160 280 0 	170 160 280 30 	25 25
			transition			loadsave			170 200 280 0 	170 200 280 30 	25 25
			transition			leavemain			170	240 280 0   170 240 280 30  25 25			
		
			setitemcolor		loadquick			forecolor		1 1 1 0
			setitemcolor		loadpoint			forecolor		1 1 1 0
			setitemcolor		loadsave			forecolor		1 1 1 0		
			setitemcolor		text				forecolor		1 1 1 0
			setitemcolor		failed				forecolor		1 1 1 0
			setitemcolor		leavemain			forecolor		1 1 1 0
			
			transition			text				180 550 400 30	180 455 260 30	30 30 
			transition			top_text			180 550 400 30	180 450 260 30	30 30
			
			transition			failed				180 -200 400 30	180  -2 260 30	30 30 
			transition			top_failed			180 -200 400 30	180  -2 260 30	30 30
					
			fadein				loadquick
			fadein				loadpoint
			fadein				loadsave
			fadein				leavemain
			fadein				text
			fadein				failed

		}
	Onclose
		{		
		}
	onEsc
		{
			play				"sound/interface/esc.wav"
			close				all //missionfailed_menu
			//open				deadloadMenu
		}
//_______________________________________________________________________________________________
//
//										ОСНОВНОЕ МЕНЮ
//_______________________________________________________________________________________________
//*********************
// Выделение текста
//*********************	
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 1 1 0.5
			visible				1
			decoration
		}
//*********************
// Затемнения фона
//*********************	
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				0
			decoration
		}
//**********************************
// Текст "Задание провалено сверху"
//**********************************			
	itemDef 
		{
			name				failed
			group				title
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			text				@SP_INGAME_MISSIONFAILED
			font				5
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER		
			textalignx			130
			textaligny			5
			forecolor			1 1 1 1
			visible				1 
			decoration 
		}
//*********************************
// Текст "Задание провалено снизу"
//*********************************
	itemDef 
		{
			name				text
			group				none
			style 				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			cvar				ui_missionfailed_text 
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER		
			textalignx			130
			textaligny			5
			forecolor			1 0 0 1
			visible				1 
			decoration 
		}
//_______________________________________________________________________________________________
//
//										КНОПКИ В МЕНЮ
//_______________________________________________________________________________________________		
//***************************
// Быстрая загрузка
//***************************	
	itemDef 
		{
			name				loadquick
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			text				@MENUS_INSTANT_LOAD_CAPS
			textalign			ITEM_ALIGN_LEFT	
			font				5
			textscale			0.5			
			textalignx			70
			textaligny			8
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			all
				uiScript  		"load_quick"						
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			180 120 270 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//***************************
// Кнопка "Контрольная точка"
//***************************	
	itemDef 
		{
			name				loadpoint
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				180 160 260 30
			text				@MENUS_LOAD_AUTOSAVE
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			15
			textaligny			8
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			all
				uiScript  		"load_auto"				// Perform screen init				
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			180 160 270 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//***************************
// Кнопка "Загрузить сохранения"
//***************************		
	itemDef 
		{
			name				loadsave
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				180 200 260 30
			text				@MENUS_LOAD_SAVE_GAME
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			50
			textaligny			8
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				close			all
				setcvar			cl_paused				"1"
				setcvar			ui_missionfailed		"1"
				open			deadloadMenu
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			180 200 270 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//***************************
// Кнопка "Выход в меню"
//***************************		
	itemDef 
		{
			name				leavemain
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			text				@MENUS_LEAVE_MAIN
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			80
			textaligny			8
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				uiScript		Quit
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			180 240 270 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//----------------------------------------------------------------------------------------
//	                              ВЫБОР МИССИИ
//----------------------------------------------------------------------------------------		
//Выбор 1 миссий
	itemDef 
		{
			name				missionselect
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				170 80 280 30
			text				@MENUS_NEW_MISSION
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			85
			textaligny			8

			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
			
			cvartest			"tier_storyinfo"
		showcvar
			{
				"1" "2" "3" "4" "5" "6"
			}			
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				setcvar			cl_paused		"1"
				uiScript		decrementforcepowerlevel
				close			all
				open			ingameMissionSelect1					
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 80 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}
//Выбор миссии 2		
	itemDef 
		{
			name				missionselect
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				170 80 280 30
			text				@MENUS_NEW_MISSION
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			85
			textaligny			8

			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4

			visible				1
			
			cvartest			"tier_storyinfo"
			showcvar
			{
				"7" "8" "9" "10" "11" "12"
			}			
		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				setcvar			cl_paused		"1"
				uiScript		decrementforcepowerlevel
				close			all
				open			ingameMissionSelect2
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow		170 80 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}	
//Выбор мисии 3
	itemDef 
		{
			name				missionselect
			group				grpControlbutton
			style				WINDOW_STYLE_SHADER
			type				ITEM_TYPE_BUTTON
			rect				170 80 280 30
			text				@MENUS_NEW_MISSION
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale			0.5
			textalignx			85
			textaligny			8
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			
			visible				1
			
			cvartest			"tier_storyinfo"
			showcvar
			{
				"13" "14" "15" "16" "17" "18"
			}	

		action 
			{ 
				play			"sound/misc/nomenu.wav"  
				setcvar			cl_paused		"1"
				uiScript		decrementforcepowerlevel
				close			all
				open			ingameMissionSelect3				
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
				setitemrect		sidebutton_glow			170 80 280 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		}		
	}
}