//----------------------------------------------------------------------------------------------
//
// SABER STYLE MENU - called from in game - allows player to change saber fighting style
//
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberstyleMenu"
		fullScreen				1					// MENU_TRUE				
		rect					0 0 640 480				// Size and position of the menu
		visible					1					// Visible on open
		focusColor				1 1 1 1					// Focus color for text and items
		descX					320
		descY					426
		descScale				1
		descColor				1 .682 0 .8
		descAlignment				ITEM_ALIGN_CENTER

	onOpen
		{ 
		
			transition			border_menu			  		  0   0 640  0   0   0 640 160 15 15 	//Фон для текста
			transition			fighting_style_text 	 	  0  40   0 30   0  40 160  30 15 15	//Текст "Текущий стиль"
			transition			fighting_style_button_1  	160  40   0 30 160  40 100  30 15 15	//Выбор: кнопка стиля
			transition			fighting_style_text2	 	320  40   0 30 320  40 160  30 15 15	//Текст "Новый стиль"
			transition			fighting_style_button_2  	480  40   0 30 480  40 100  30 15 15	//Выбор: кнопка стиля
						
			setitemrect			saber			   			-300 -250 950 700					//Меч		
		/*
			
			transition			back			      0 450   0 30   0  450 120 30 15 15	//Кнопка "Назад"
			transition			next			    520 450   0 30 520  450 120 30 15 15	//Кнопка "Вперед"
			transition			continue		    520 450   0 30 520  450 120 30 15 15	//Кнопка "Продолжить"

			*/
		//Скрипты
			uiScript  			"getsabercvars"
			uiScript  			"updatefightingstylechoices"
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
		}							
	onESC 
		{ 
			play				"sound/interface/esc.wav" 					
			//uiScript		 	"updatesabercvars"
			close				all
		}
//_______________________________________________________________________________________________
//
//								ЭЛЕМЕНТЫ МЕНЮ
//_______________________________________________________________________________________________
//*********
// Фон меню
//*********
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"groundmenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//*********
// Фон для текста
//*********
	 itemDef 
		{
			name				border_menu
			style				WINDOW_STYLE_FILLED
			rect				-2  -2 342.5 280.5
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
		}
//*********
// BLUR
//*********
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//*********
// Выделение элементов
//*********
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			decoration
		}
//_______________________________________________________________________________________________
//
//								ВЫБОР СТИЛЬ МЕЧА В МЕНЮ
//_______________________________________________________________________________________________	
//****************
// Текст: Текущий стиль
//****************
	itemDef 
		{
			name				fighting_style_text
			text				@MENUS_CURRENT_STYLE
			descText			@MENUS_ADDFIGHTINGSTYLE
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			
			textalign			ITEM_ALIGN_LEFT
			visible				1
			decoration
		}	
//****************
// Стиль меча
//****************
	itemDef 
		{
			name				fighting_style_button_1
			text				" "
			textalign			ITEM_ALIGN_LEFT
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
					
			cvar				"ui_currentfightingstyle"
		cvarStrList
			{
				@MENUS_COMBATSTYLEFAST     "0"
				@MENUS_COMBATSTYLEMEDIUM   "1"
				@MENUS_COMBATSTYLEHEAVY    "2"
			}
			visible				1			 
		}
//****************
// Текст: Новый стиль
//****************
	itemDef 
		{
			name				fighting_style_text2
			text				@MENUS_NEW_STYLE
			descText			@MENUS_ADDFIGHTINGSTYLE
			textalign			ITEM_ALIGN_LEFT
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			
			visible				1
		}
//****************
// Стиль меча
//****************		
	itemDef 
		{
			name				fighting_style_button_2
			text				" "
			type				ITEM_TYPE_MULTI
			textalign			ITEM_ALIGN_LEFT
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			visible				1
			
			cvar				"ui_newfightingstyle"
		cvarStrList
				{
					@MENUS_COMBATSTYLEFAST     "0"
					@MENUS_COMBATSTYLEHEAVY    "2"
				}
		mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		330 20 300 40
			}
		mouseExit 
			{ 
				hide			button_glow
			}	  	  
		action 
			{
				play			"sound/interface/button1.wav" 
			}
		}
			
	itemDef 
		{
			name				new_fightingstyle_desc
			type				ITEM_TYPE_TEXTSCROLL
			text				@SP_INGAME_FAST_STYLE
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			rect				20 100 600 200
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1			
			cvartest			"ui_newfightingstyle"
		showcvar
				{
					"0"
				}
			lineHeight			14
			visible				1			 
			autowrapped
		}
	
	itemDef 
		{
			name				new_fightingstyle_desc
			type				ITEM_TYPE_TEXTSCROLL
			text				@SP_INGAME_STRONG_STYLE
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			rect				20 100 580 200
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1			
			
			cvartest			"ui_newfightingstyle"
		showcvar
			{
				"2"
			}

			lineHeight			14
			visible				1			 
			autowrapped
		}
//----------------------------------------------------------------------------------------------
//SABER MODELS
//----------------------------------------------------------------------------------------------
	itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-100 -180 750 750
			asset_model			"models/weapons2/saber_reborn/saber_w.glm"
			isSaber				1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
			model_g2maxs		20 20 20
			model_fovx			75
			model_fovy			75
			visible				1
			decoration
		}	
