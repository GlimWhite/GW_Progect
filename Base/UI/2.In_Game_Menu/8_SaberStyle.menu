//----------------------------------------------------------------------------------------------
//
// SABER STYLE MENU - called from in game - allows player to change saber fighting style
//
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberstyleMenu"
		fullScreen				1					// MENU_TRUE				
		rect					0 0 640 480				// Size and position of the menu
		visible					1					// Visible on open
		focusColor				1 1 1 1					// Focus color for text and items
		descX					320
		descY					426
		descScale				1
		descColor				1 .682 0 .8
		descAlignment				ITEM_ALIGN_CENTER

	onOpen
		{ 
			uiScript  			"getsabercvars"
			uiScript  			"updatefightingstylechoices"
			setfocus			new_fightingstyle_button
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
		}							
	onESC 
		{ 
			play				"sound/interface/esc.wav" 					
			//uiScript		 	"updatesabercvars"
			close				all
		}
//----------------------------------------------------------------------------------------------
//	MENU BACKGROUND
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/sabermenu_back"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

	itemDef 
		{
			name				button_glow
			group				mods
			style				WINDOW_STYLE_SHADER
			rect				455 444 130 24 
			background			"menu/menu_buttonback"
			forecolor			0.2 0.2 0.2 0.5
			visible				0
			decoration
		}
	itemDef 
		{
			name				title_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 -2 640 25
			background			"menu/menu_buttonback"
			forecolor			0.2 0.2 0.2 0.5
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//	SABER COMBAT STYLES
//----------------------------------------------------------------------------------------------
// Current fighting style
	itemDef 
		{
			name				fightingstylebutton1
			group				none
			text				@MENUS_CURRENT_STYLE
			descText			@MENUS_ADDFIGHTINGSTYLE
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				10 30 300 30
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			textstyle			1
			textalignx			20
			textaligny			2
			forecolor			.95 .64 .37 1
					
			cvar				"ui_currentfightingstyle"
		cvarStrList
			{
				@MENUS_COMBATSTYLEFAST     "0"
				@MENUS_COMBATSTYLEMEDIUM   "1"
				@MENUS_COMBATSTYLEHEAVY    "2"
			}
			visible				1			 
		}
	itemDef 
		{
			name				new_fightingstyle_button
			group				none
			text				@MENUS_NEW_STYLE
			descText			@MENUS_ADDFIGHTINGSTYLE
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				330 30 300 30
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			textalignx			20
			textaligny			2
			forecolor			.95 .64 .37 1
			visible				1
						
			cvar				"ui_newfightingstyle"
			cvarStrList
				{
					@MENUS_COMBATSTYLEFAST     "0"
					@MENUS_COMBATSTYLEHEAVY    "2"
				}
		mouseEnter 
			{ 
				show			button_glow
				setitemrect		button_glow		330 20 300 40
			}
		mouseExit 
			{ 
				hide			button_glow
			}	  	  
		action 
			{
				play			"sound/interface/button1.wav" 
			}
		}
	itemDef 
		{
			name				new_fightingstyle_desc
			group				none
			type				ITEM_TYPE_TEXTSCROLL
			text				@SP_INGAME_FAST_STYLE
			style				WINDOW_STYLE_EMPTY
			rect				20 100 600 200
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1			
			cvartest			"ui_newfightingstyle"
		showcvar
				{
					"0"
				}
			lineHeight			14
			visible				1			 
			autowrapped
		}
	itemDef 
		{
			name				new_fightingstyle_desc
			group				none
			type				ITEM_TYPE_TEXTSCROLL
			text				@SP_INGAME_STRONG_STYLE
			style				WINDOW_STYLE_EMPTY
			rect				20 100 580 200
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1			
			cvartest			"ui_newfightingstyle"
			showcvar
			{
				"2"
			}

			lineHeight			14
			visible				1			 
			autowrapped
		}
//----------------------------------------------------------------------------------------------
//SABER MODELS
//----------------------------------------------------------------------------------------------
	itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-100 -180 750 750
			asset_model			"models/weapons2/saber_reborn/saber_w.glm"
			isSaber				1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
			model_g2maxs		20 20 20
			model_fovx			75
			model_fovy			75
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//	Галаграмма экрана
//----------------------------------------------------------------------------------------------
//Граница: Информации о стиле
	itemDef 
		{
			name				briefing_background
			group				none
			style				WINDOW_STYLE_FILLED
			background				"BoxMenu"
			rect				-2 -40 644 530
			backcolor			.03 .12 0.8 0.4
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//   SABER MENU specific stuff
//----------------------------------------------------------------------------------------------
// Screen title
		itemDef 
		{
			name				title
			group				title
			style				WINDOW_STYLE_EMPTY
			text				@MENUS_CHOOSE_SABER_STYLE
			rect				20 4 620 25
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER		
			textalignx			320
			textaligny			-1	
			forecolor			.549 .854 1 1
			
			visible				1 
			decoration 
		}
//----------------------------------------------------------------------------------------------
//	Эллементы выше других
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				continue
			group				none
			text				@MENUS_CONTINUE
			descText			@MENUS_NEW_MISSION_DESC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				250 444 160 25 
			font				5
			textscale			0.5
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_LEFT
			visible				1
			
			textalignx			30
			textaligny			6		
			background			"BoxMenuVertex"

		action 
			{ 
				uiScript 		"updatesabercvars"
				uiScript 		"updatefightingstyle"
				close			all
				setcvar			tier_storyinfo	"7"
				setcvar			storyhead	"protocol"
				open			ingameGotoTier
				// HACK We're expecting to go to a mission screen from here
				playvoice		"sound/chars/storyinfo/7.mp3"
			}
		mouseEnter 
			{ 				
				show			button_glow
				setitemrect		button_glow		250 444 160 24 
				setitemrect		continue		252 446 156 22
			}
		mouseExit 
			{ 
				hide			button_glow
				setitemrect		continue		250 444 160 25
			}	 			
		}
//Text
	itemDef 
		{
			name				redux
			group				redux
			text				"REDUX"
			rect				615 468 0 0
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}

	}
}
