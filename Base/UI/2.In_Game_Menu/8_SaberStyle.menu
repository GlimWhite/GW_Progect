//----------------------------------------------------------------------------------------------
//
// SABER STYLE MENU - called from in game - allows player to change saber fighting style
//
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberstyleMenu"
		fullScreen				1					// MENU_TRUE				
		rect					0 0 640 480				// Size and position of the menu
		visible					1					// Visible on open
		focusColor				1 1 1 1					// Focus color for text and items
		descX					320
		descY					232
		descScale				1
		descColor				1 .682 0 .8
		descAlignment				ITEM_ALIGN_CENTER

	onOpen
		{ 
		
			transition			border_menu			  		320 240 0  0  -5  -5 646 260 15 15 	//Фон для текста
			
			transition			title 	 	 				120   5 0 30 120   5 435  30 15 15	//Текст "Текущий стиль"
			transition			fighting_style_text 	 	 40  40 0 30  20  40 160  30 15 15	//Текст "Текущий стиль"
			transition			fighting_style_button_1  	180  40 0 30 180  40 100  30 15 15	//Выбор: кнопка стиля
			transition			fighting_style_text2	 	360  40 0 30 360  40 160  30 15 15	//Текст "Новый стиль"
			transition			fighting_style_button_2  	520  40 0 30 520  40 100  30 15 15	//Выбор: кнопка стиля
						
			setitemrect			saber			   			-300 -125 950 700					//Меч		
		//Скрипты
			uiScript  			"getsabercvars"
			uiScript  			"updatefightingstylechoices"
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
		}							
	onESC 
		{ 
			play				"sound/interface/esc.wav" 					
			//uiScript		 	"updatesabercvars"
			close				all
		}
//_______________________________________________________________________________________________
//
//								ЭЛЕМЕНТЫ МЕНЮ
//_______________________________________________________________________________________________
//*********
// Фон меню
//*********
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"groundmenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//*********
// Фон для текста
//*********
	 itemDef 
		{
			name				border_menu
			style				WINDOW_STYLE_FILLED
			rect				-2  -2 342.5 280.5
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
		}
//*********
// BLUR
//*********
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//*********
// Выделение элементов
//*********
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			decoration
		}
//*********
// Титул меню
//*********		
	itemDef 
		{
			name				title
			text				@MENUS_CHOOSE_SABER_STYLE
			style				WINDOW_STYLE_SHADER
			background			"box_blue"
			font				3
			textstyle				3
			textscale			1.1
			textalign			ITEM_ALIGN_LEFT	
			textalignx			20
			forecolor			1 1 1 1
			visible				1 
			decoration 
		}
//_______________________________________________________________________________________________
//
//								ВЫБОР СТИЛЬ МЕЧА В МЕНЮ
//_______________________________________________________________________________________________	
//****************
// Текст: Текущий стиль
//****************
	itemDef 
		{
			name				fighting_style_text
			text				@MENUS_CURRENT_STYLE
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			
			textalign			ITEM_ALIGN_LEFT
			visible				1
			decoration
		}	
//****************
// Стиль меча
//****************
	itemDef 
		{
			name				fighting_style_button_1
			text				" "
			textalign			ITEM_ALIGN_LEFT
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
					
			cvar				"ui_currentfightingstyle"
		cvarStrList
			{
				@MENUS_COMBATSTYLEFAST     "0"
				@MENUS_COMBATSTYLEHEAVY    "1"
				@MENUS_COMBATSTYLEMEDIUM   "2"
			}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow			20 40 260 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	
			visible				1		
			decoration
		}
//****************
// Текст: Новый стиль
//****************
	itemDef 
		{
			name				fighting_style_text2
			text				@MENUS_NEW_STYLE
			textalign			ITEM_ALIGN_LEFT
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			visible				1
			dicoration
		}
//****************
// Стиль меча
//****************		
	itemDef 
		{
			name				fighting_style_button_2
			text				@MENUS_CHOOSE
			type				ITEM_TYPE_MULTI
			descText			@MENUS_ADDFIGHTINGSTYLE
			textalign			ITEM_ALIGN_LEFT
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			visible				1
			
			cvar				"ui_newfightingstyle"
		cvarStrList
				{
					@MENUS_COMBATSTYLEFAST     "0"
					@MENUS_COMBATSTYLEHEAVY    "2"
				}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow			360 40 260 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
		action 
			{
				play			"sound/interface/button1.wav" 
			}
		}
//****************
// Описание стиля быстрый
//****************				
	itemDef 
		{
			name				new_fightingstyle_desc
			type				ITEM_TYPE_TEXTSCROLL
			text				@SP_INGAME_FAST_STYLE
			style				WINDOW_STYLE_SHADER
			background			"box_blue"
			rect				20 80 600 150
			font				3
			textstyle			3
			textscale			1.1
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1			
			cvartest			"ui_newfightingstyle"
		showcvar
				{
					"0"
				}
			lineHeight			14
			visible				1			 
			autowrapped
		}
//****************
// Описания стиля быстрый
//****************		
	itemDef 
		{
			name				new_fightingstyle_desc
			type				ITEM_TYPE_TEXTSCROLL
			text				@SP_INGAME_STRONG_STYLE
			style				WINDOW_STYLE_SHADER
			background			"box_blue"
			rect				20 80 600 150
			font				3
			textstyle			3
			textscale			1.1
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1			
			
			cvartest			"ui_newfightingstyle"
		showcvar
			{
				"2"
			}

			lineHeight			14
			visible				1			 
			autowrapped
		}
		
		//###########################
		//#		SABER MODELS		#
		//###########################
		
	itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-100 -180 750 750
			asset_model			"models/weapons2/saber_reborn/saber_w.glm"
			isSaber				1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
			model_g2maxs		20 20 20
			model_fovx			75
			model_fovy			75
			visible				1
			decoration
		}	
		
		//###########################
		//#	   Кнопка ПРОДОЛЖИТЬ	#
		//###########################
		
	itemDef 
		{
			name				continue
			text				@MENUS_CONTINUE
			descText			@MENUS_NEW_MISSION_DESC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				250 444 160 30 
			font				3
			textstyle			3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_LEFT
			visible				1
			
			textalignx			20		
			textaligny			0
			background			"BoxMenuVertex"

		action 
			{ 
				uiScript 		"updatesabercvars"
				uiScript 		"updatefightingstyle"
				close			all
				setcvar			tier_storyinfo	"7"
				setcvar			storyhead	"protocol"
				open			ingameGotoTier
				// HACK We're expecting to go to a mission screen from here
				playvoice		"sound/chars/storyinfo/7.mp3"
			}
		mouseEnter 
			{ 				
				show			sidebutton_glow
				setitemrect		sidebutton_glow		250 444 160 24 
				setitemrect		continue			252 446 156 24
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
				setitemrect		continue			250 444 160 30
			}	 			
		}

	}
}
