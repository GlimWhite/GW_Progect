//_______________________________________________________________________________________________
// 									INGAME CONTROLS MENU
//							Player can change key bindings from ingame
//_______________________________________________________________________________________________
{
	menuDef 
	{
		name						"ingameControlsMenu"
		fullScreen					0							// MENU_TRUE				
		rect						0 0 640 480					// Size and position of the menu
		visible						1							// Visible on open
		focusColor					1 1 1 1						// Focus color for text and items	
	onOpen 
		{
			uiScript 				loadControls
			
			setitemcolor			movementcontrolbutton		forecolor					1 1 1 0
			setitemcolor			mousejoystickcontrolbutton	forecolor					1 1 1 0
			setitemcolor			weaponscontrolbutton		forecolor					1 1 1 0
			setitemcolor			forcecontrolbutton			forecolor					1 1 1 0
			
			show					backbutton2
			show					movecontrols
			show					other_text
			
			transition				backcontrols				 -2   30 640  0 -2 30 640 448 15 15
			transition				sidebutton_glow_red			 -2    0 160 30 -2  0 160  30 15 15
			
			transition				movementcontrolbutton		 -2 -100 160 30  -2 0 160  30 15 15
			transition				mousejoystickcontrolbutton	478 -100 160 30 478 0 160  30 15 15
			transition				weaponscontrolbutton  		158 -100 160 30 158 0 160  30 15 15
			transition				forcecontrolbutton			318 -100 160 30 318 0 160  30 15 15
			transition				sidebutton_glow_red	 		  0 -100 160 30   0 0 160  30 15 15
	
			hide					weaponcontrols
			hide					forcecontrols
			hide					joycontrols
			hide					backbutton
			hide					other_text
			hide					ffwarning
			
			fadein					movementcontrolbutton
			fadein					mousejoystickcontrolbutton
			fadein					weaponscontrolbutton
			fadein					forcecontrolbutton
		}
	onClose 
		{
			uiScript 				saveControls
			hide					ffwarning
			open					ingameMainMenu
		}
			
	onESC 
		{ 
			play					"sound/interface/esc.wav" 
			hide					ffwarning
			hide					sidebutton_glow			
			close					all
			open					ingameMainMenu
		}
//_______________________________________________________________________________________________
//
//	СТРУКТУРА МЕНЮ
//_______________________________________________________________________________________________
//*********
// BLUR
//*********
	itemDef 
		{
			name				Blur
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/blur"
			forecolor			1 1 0.9 0.45
			visible				1
			decoration
		}
//*********
// Выделение элементов (Синий)
//*********
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			decoration
		}
//*********
// Выделение элементов (Красный)
//*********
	itemDef 
		{
			name				sidebutton_glow_red
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendboxr"
			forecolor			.95 .64 .37 1
			decoration
		}
//*********
// Фон
//*********
	itemDef 
		{
			name				backcontrols
			style				WINDOW_STYLE_FILLED
			rect				-2 30 640 448	
			bordersize			2
			border				1
			bordercolor			1 1 1 1
			backcolor			.1 .1 .6 .5
			decoration
			visible				1
		}	
//_______________________________________________________________________________________________
//
//								МЕНЮ ДВИЖЕНИЯ (ВКЛАДКА)
//_______________________________________________________________________________________________
//*********
// КНОПКА: "ДВИЖЕНИЕ"
//*********
	itemDef 
		{
			name				movementcontrolbutton
			group				text_menu
			text				@MENUS_MOVEMENT
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				-2 0 160 30
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1			
			textalignx			40
			textaligny			0
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		mouseEnter 			
			{ 
				show				sidebutton_glow
				setitemrect			sidebutton_glow	-2 0 160 30 ;
			}
		mouseExit 			
			{ 
				hide				sidebutton_glow
			}
		action 
			{ 
				play				sound/interface/sub_select 
				
				transition			backcontrols				-2 30 640  0 -2 30 640 448 15 15
				transition			sidebutton_glow_red			-2  0 160 30 -2  0 160  30  0  0
				
				hide 				weaponcontrols 
				hide				forcecontrols 
				hide				joycontrols 
				hide				other_text
				hide				backbutton
				
				show				backbutton2
				show				movecontrols_text
				show				movecontrols		
			}
		}
//_______________________________________________________________________________________________
//								НАСТРОЙКА ДВИЖЕНИЙ
