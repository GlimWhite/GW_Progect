			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				318 0 160 30
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1			
			textalignx			30
			textaligny			0
			visible				1
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow 		320 0 158 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}		  	  
		action 
			{ 
				play			sound/interface/sub_select 
				transition		backcontrols				100 50 440  0 100 50 440 340 15 15
				setitemrect		sidebutton_glow_red			320  0 158 30
				
				hide			movecontrols_text
				hide			movecontrols 
				hide			joycontrols 
				hide			other_text
				hide 			weaponcontrols 
				hide			backbutton2
				
				show			backbutton
				show			forcecontrols 
			}
		}
