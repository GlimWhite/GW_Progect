			textalignx			120
			font				4
			textstyle			5
			textscale			1.05
			forecolor			.95 .64 .37 1
			
			visible				1
		action 					{ play sound/interface/button1 }
		mouseenter 
			{
			show				sidebutton_glow
			setitemrect			sidebutton_glow		180 40 300 20
			}
		mouseexit 
			{ 
			hide				sidebutton_glow
			}
		}
