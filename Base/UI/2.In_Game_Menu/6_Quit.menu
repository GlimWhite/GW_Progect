//___________________________________________________________________________________________
//	
//								QUIT MENU/ Меню выхода
//___________________________________________________________________________________________
{
	menuDef 
	{
		name					"ingamequitMenu"	
		fullScreen				1					
		focusColor				1 1 1 1			
		visible					1					
	onESC 
		{ 
			play				"sound/interface/esc.wav" 					
			close				ingamequitMenu ; 
			open				InGameMainMenu ;
		}
	OnClose
		{
			close				quitMenu
		}
	onOpen 
		{
		}	
//___________________________________________________________________________________________
//	
//								Основное меню
//___________________________________________________________________________________________
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			visible				1
			decoration
		}
//******************
// 		BLUR
//******************
	itemDef 
		{
			name				Blur
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/blur"
			forecolor			0.5 0.5 0.5 0.45
			visible				1
			decoration
		}
//*******************************
//	ВЫДЕЛЕНИЕ СТРОКИ	
//*******************************
	itemDef 
		{
			name				sidebutton_glow
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			decoration
		}		
//*******************************
// Фон для текста предупреждения
//*******************************
	itemDef 
		{
			name				text
			style				WINDOW_STYLE_FILLED	
			background			"BoxMenu"
			rect				120 120 420 250
			border				1
			bordersize			1
			bordercolor			1 1 1 1
			decoration			
			visible				1
		}
//*********************
// Текст "Информация"
//*********************
	itemDef 
		{
			name				options
			text				@MENUS_QUIT_JEDI_KNIGHT_II
			textalignx			10
			textaligny			10
			rect				320 175 290 20
			textalign			ITEM_ALIGN_CENTER
			forecolor			.95 .64 .37 1
			font 				5
			textstyle			5
			textscale 			0.60
			visible				1

			decoration
		}
//**************
// Кнопка "Да"
//**************
	itemDef 
		{
			name				default_yes
			group				videowarning
			text				@MENUS_YES
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				185 300 60 30
			textalign			ITEM_ALIGN_LEFT
			font 				5
			textstyle			5
			textscale 			0.6
			textalignx			20
			textaligny			4
			forecolor			.95 .64 .37 1
			visible				1
			
			background			"menu/box_redux"
		mouseEnter
			{
				show				sidebutton_glow
				setitemrect			sidebutton_glow			185 300 60 30
			}
		mouseExit	
			{
				hide				sidebutton_glow
			}			
		action 
			{ 
				play			"sound/interface/esc.wav" 
				uiScript		Quit 
			}	  	  
		}
//**************
// Кнопка "Нет"
//**************
	itemDef 
		{
			name				default_no
			group				videowarning
			text				@MENUS_NO
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				415 300 60 30
			textalign			ITEM_ALIGN_LEFT
			font				5
			textstyle			5
			textscale 			0.6
			textalignx			17
			textaligny			4
			forecolor			.95 .64 .37 1
			visible				1

			background			"menu/box_redux"	
		mouseEnter
			{
				show				sidebutton_glow
				setitemrect			sidebutton_glow			415 300 60 30
			}
		mouseExit	
			{
				hide				sidebutton_glow
			}			
		action 
			{ 
				play			"sound/interface/esc.wav" 					
				close			ingamequitMenu ; 
				open			InGameMainMenu ;
			}	
		}
//___________________________________________________________________________________________
//
//										ЭЛЕМЕНТЫ В МЕНЮ ВЫШЕ ДРУГИХ
//___________________________________________________________________________________________		
	itemDef 
		{
			name				academy
			group				none
			style				WINDOW_STYLE_SHADER
			rect				220 -1 200 75
			background			"academy"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	}
	
}

















