//_______________________________________________________________________________________________
// 									ВНУТРИИГРОВОЕ МЕНЮ НАСТРОЙКИ ГРАФИКИ					
//_______________________________________________________________________________________________
{
	menuDef 
	{
		Name						"InGameSetupMenu"
		FullScreen					0								
		Rect						0 0 640 480			
		Visible						1				
		FocusColor					1 1 1 1			
	onOpen 
		{
		uiScript					getvideosetup 
		
			hide						group_defaults
			hide						group_sound
			hide						group_graphics
			hide						ApplyChanges 
			hide						group_vidrestart 
			
			show						defaults
			show						group_screen
			show						group_menu
			show						group_screen
			show 						redux
			show						sidebutton_glow_red
			
			transition					border_setup	   	 	 80   57 480  0  80 57 480 412 15 15
			transition					Videobutton				  0 -100 160 30   0  0 160  30 15 15
			transition					Graphicsbutton			160 -100 160 30 160  0 160  30 15 15
			transition					Soundbutton				320 -100 160 30 320  0 160  30 15 15
			transition					Defaultsbutton			480 -100 160 30 480  0 160  30 15 15
			transition					sidebutton_glow_red	 	  0 -100 160 30   0  0 160  30 15 15
			
			setitemrect					escapebutton			530   58  30 28  	
		}
	onClose
		{
			open					ingameMainMenu
		}	
	onESC 
		{ 
			play					"sound/interface/esc.wav" 					
			defer					VideoSetup				VideoWarningGameMenu
			close					InGameSetupMenu
			open					ingameMainMenu
		}
//_______________________________________________________________________________________________
//
//									MENU SETUP/МЕНЮ НАСТРОЙКИ
//_______________________________________________________________________________________________
//********************
// Фон для меню
//********************		
	itemDef 
		{
			name				Blur
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/blur"
			forecolor			1 1 0.9 0.45
			visible				1
			decoration
		}
//********************
// Поля для настроек
//********************
	itemDef 
		{
			name				border_setup	
			group				group_menu
			style				WINDOW_STYLE_FILLED
			backcolor			.1 .1 .6 .5
			border				1
			bordercolor			1 1 1 1
			decoration	
		mouseEnter 			
			{ 	
				setitemcolor	border_setup		bordercolor			1 1 1 1
			}
		mouseExit 			
			{
				setitemcolor	border_setup		bordercolor			0 0 1 1
			}
		}
//********************
// Выделение текста (Синий)
//********************	
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			decoration
		}
//*********
// Выделение элементов (Красный)
//*********
	itemDef 
		{
			name				sidebutton_glow_red
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendboxr"
			forecolor			.95 .64 .37 1
			decoration
		}		
//----------------------------------------------------------------------------------------------
//									ОСНОВНОЕ КОНТЕКСТНОЕ МЕНЮ
//----------------------------------------------------------------------------------------------
//********************
// Кнопка "Изображение"
//********************	
	itemDef 
		{
			name					videobutton	
			group					group_menu
			text					@MENUS_SCREEN
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_SHADER
			textalign				ITEM_ALIGN_LEFT
			forecolor				1 1 1 1
			textstyle				3
			font					3
			textscale				1
			textalignx				55
			textaligny				0
			visible					1
			
			background				"BoxMenu"
			
		mouseEnter 			
			{ 	
				show				sidebutton_glow 
				setitemrect			sidebutton_glow		-2 0 160 30
			}
		mouseExit 			
			{
				hide 				sidebutton_glow
			}
		action 
			{ 
				play				sound/interface/sub_select 
				defer				VideoSetup				videowarningMenu 
				uiScript			getvideosetup 	   		// Get video settings
					
				transition			border_setup	   		80  57 480  0  80 57 480 412 15 15
				setitemrect			escapebutton	    	530 58 30 28
				setitemrect			sidebutton_glow_red 	0 0 160 30
				show				group_screen
				show				defaults
				
				hide				group_defaults	
				hide				group_sound
				hide				group_vidrestart
				hide				group_graphics
				hide				applyChanges  
			}
		}
//********************
// Кнопка "Графика"
//********************	
itemDef 
		{
			name					Graphicsbutton
			group					group_menu
			text					@MENUS_GRAPHICS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_SHADER
			textalign				ITEM_ALIGN_LEFT
			forecolor				1 1 1 1
			textstyle				3
			font					3
			textscale				1
			textalignx				52
			visible					1
			
			background				"BoxMenu"
			
		mouseEnter
			{ 
				show				sidebutton_glow ; 	
				setitemrect			sidebutton_glow 		160 0 160  30
			}
		mouseExit 		
			{ 
				hide 				sidebutton_glow 
			}
		action 
			{ 
				play				sound/interface/sub_select 
				defer				VideoSetup	videowarningMenu 	
				
				transition			border_setup	   		-2 30 641 0 -2 30 641 448 15 15
				setitemrect			escapebutton	   		608 33 30 28
				setitemrect			sidebutton_glow_red		160 0 160 30
				show				group_graphics
				show				defaults
				
				hide				group_screen
				hide				group_defaults	
				hide				group_sound
				hide				group_vidrestart
				hide				applyChanges  			
			}
		}
//********************
// Кнопка "Звук"
//********************	
	itemDef 
		{
			name					soundbutton	
			group					group_menu
			text					@MENUS_SOUNDED
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_SHADER
			textalign				ITEM_ALIGN_LEFT
			forecolor				1 1 1 1
			textstyle				3
			font					3
			textscale				1
			textalignx				60
			visible					1
			
			background				"BoxMenu"
			
		mouseEnter
			{ 
				show				sidebutton_glow 	
				setitemrect			sidebutton_glow 	320 0 160  30
			}
		mouseExit 		
			{ 
				hide 				sidebutton_glow 
			}
		action 
			{ 
				play				sound/interface/sub_select 
				defer				VideoSetup			videowarningMenu 	
				
				transition			border_setup	  	80 57 480 0 80 57 480 412 15 15
				setitemrect			escapebutton	    530 58 30 28
				setitemrect			sidebutton_glow_red	320 0 160 30
				show				group_sound
				
				hide				group_graphics
				hide				group_screen
				hide				group_defaults	
				hide				defaults
				hide				group_vidrestart
				hide				applyChanges
			}
		}
//********************
// Кнопка "Выйти"
//********************	
	itemDef
		{
			name					escapebutton
			group					group_menu
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_FILLED
			background				"Escape"
			border					1
			bordercolor				0.5 0.5 0.5 1
			visible					0		
		mouseEnter 			
			{
				setitemcolor		escapebutton	bordercolor	1 1 1 1	
			}
		mouseExit 			
			{ 
				setitemcolor		escapebutton	bordercolor	0.5 0.5 0.5 0.5	
			}
		action 
			{ 
				play				"sound/interface/esc.wav"
				close				all
				open				ingameMainMenu				
			}
		}
//_______________________________________________________________________________________________
//
//							MENU SCREEEN/ МЕНЮ ЭКРАН (НАСТРОЙКА ЭКРАНА)
