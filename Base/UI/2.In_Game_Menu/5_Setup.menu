//********************
// "Полный экран"
//********************
	itemDef  
		{	
			name				fullscreen_text
			group				group_screen
			text				@MENUS_FULL_SCREEN
			rect				170 90 250 20
	   		textalign			ITEM_ALIGN_LEFT
			font				4
			textstyle			5
			textscale			1.05
			forecolor			.95 .64 .37 1
			decoration
		}
	itemDef 
		{	
			name				fullscreen
			group				group_screen
			type				ITEM_TYPE_MULTI
			text				" "
			rect				160 90 300 20
	   		textalign			ITEM_ALIGN_LEFT
			font 				5
			textstyle			5
			textscale 			0.45
			textalignx			200
			forecolor			1 1 1 1
			textaligny			2

			cvarFloatList		{  @MENUS_OFF 0 @MENUS_ON 1 }
			cvar				"ui_r_fullscreen"
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow			120 90 420 20
			} 
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
				play			"sound/interface/button1.wav"  
				uiScript		glCustom 
				setcvar			ui_r_modified	1 
				show			applyChanges
			}
		}
