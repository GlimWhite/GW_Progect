		{
			name				VIDEOQ
			group				group_screen
			type				ITEM_TYPE_MULTI
			text				" "
			cvar				"cl_VideoQuality"	
			cvarFloatList		{ @MENUS_LOW 0 @MENUS_HIGH 1 }
			rect				160 320 320 20
