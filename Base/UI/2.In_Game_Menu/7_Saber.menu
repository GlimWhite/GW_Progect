//----------------------------------------------------------------------------------------
// 			SABER CREATION MENU - called from main menu at the the start of a new game, 
//     and also when player is allowed to upgrade the fighting style and choose a new saber
//----------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberMenu"
		fullScreen				1					// MENU_TRUE				
		visible					1					// Visible on open
		focusColor				1 1 1 1				// Focus color for text and items	
	onOpen
		{	
		//Титутл
			transition			create_title	   -345   0 370 20 -25   0 370  20 15 15
			
			transition			typebut		   	      0  20 120  0   0 20 120  90 15 15		//Текст "Тип меча"
			transition			typebut_single	    120  20   0 30 120 20 200  30 15 15		//Кнопка "Одноручный"
			//transition			typebut_dual	    120  50 120 30 120 50 200  30 15 15		//Кнопка "Двуручный"
			//transition			typebut_staff	    120  80 120 30 120 80 200  30 15 15		//Кнопка "Посох"	
			transition			saberstyle	  	   -345 249 120 30  14 249 200  30 15 15	//Кнопка "Стиль"
					
		//Нефисы
			transition			box_hilttype	   -345 191 342 30	-2 191 342  30 15 15
			transition			hiltbut			   -345 205 120 30	14 205 120  40 15 15
			transition			hiltbut2		   -345 205 120 30  14 249 120  40 15 15
			transition			hiltbut_staves	   -345 205 120 30  14 205 120  40 15 15
		//Цвета
			transition			box_color1			640  15 342 30	340 15 298 	30 15 15
			transition			color_title			640   0 370 20  320  0 370  20 15 15
			transition			border_color		640  -2 298 17 	340 -2 298  17 15 15
			transition			box_color2			640  59 342 30	340 59 298 	30 15 15
			hide				box_color2
		//Назад
			transition			box_back	         -2 448 170  32	 -2 448 170  32 15 15
			transition			back			     55 450 120  24  55 450 120  24 15 15
		//Далее
			transition			box_next	   		168 448 170  32 168 448 170  32 15 15
			transition			next			    210 450 120  32 210 450 120  32	15 15
			transition			continue		    210 450 120  32 210 450 120  32	15 15
		//Лазерный меч
			transition			saber			  -200 -200 900 700	-200 -200 900 700 15 15 
		//Фон для меню
			transition			border_menu		   -345  -2 342 280	-2  -2   342.5 280.5 15 15
			*//
		//Переменные
			setcvar				"playersave" "(NULL)"
			setcvar				"tiers_complete" "(NULL)"
		//Подключение скриптов игры
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			uiScript  			"getsabercvars"
			uiScript  			"updatefightingstylechoices"
			uiScript  			"resetsabercvardefaults"
		}	
	onESC 
		{ 
			play				"sound/interface/esc.wav" 
			
			uiScript		 	"updatesabercvars"
			uiScript			closesabermenu		
		}
//----------------------------------------------------------------------------------------
//											ФОН МЕНЮ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"groundmenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		/*
//Бардюр под меню с левой сторны
	 itemDef 
		{
			name				border_menu
			style				WINDOW_STYLE_FILLED
			rect				-2  -2 342.5 280.5
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
		}
*/
//*********
// BLUR
//*********
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//*********
// Выделение элементов
//*********
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			visible				0
			decoration
		}
//_______________________________________________________________________________________________
//								ВЫБОР ТИП МЕЧА В МЕНЮ
//_______________________________________________________________________________________________
//*********
//Текст :"Тип меча"
//*********
	itemDef 
		{
			name				typebut
			text				@MENUS_SABER_TYPE
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT	
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			20
			textaligny			30
			background			"BoxMenu"	
			visible				1
			
			decoration
		}

			//##############################
			//#		  ОДНОРУЧНЫЙ МЕЧ	   #
			//##############################
			
	itemDef 
		{
			name				typebut_single
			group				single_group
			text				@MENUS_SINGLESABER
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			type				ITEM_TYPE_BUTTON
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textalignx			30
			textscale			1.1
			forecolor			1 1 1 1
			visible				1
			
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  59 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
			play				"sound/interface/choose_saber.wav"
				//Переменные
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		"single_1"
				//Перемещение
				transition 		saber 			-200 -200 900 700 -200 -125 900 700 15 15
				transition		saber2			-200 -200 900 700 -200 -225 900 700 15 15 
				//Смена
				show			single_group
				show			dual_group
				hide			staff_group
				hide			typebut_single
				hide			colorbut2
				hide			box_color2	
				//Скрипт
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				uiScript  		"updatefightingstylechoices"
				exec            "playermodel player_2"
			}
		}

			//##############################
			//#		  ДВУХРУЧНЫЙ МЕЧ	   #
			//##############################
			

	itemDef 
		{
			name				typebut_dual
			group				dual_group
			text				@MENUS_DUALSABERS
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			type				ITEM_TYPE_BUTTON
			textalign			ITEM_ALIGN_LEFT
			rect				120 20 200 30
			textstyle			3
			font				3
			textalignx			30
			textscale			1.1
			forecolor			1 1 1 1
			visible				0

		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  103 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
			play				"sound/interface/choose_saber.wav"
				//Перемещение
				transition		saber			-100 -200 900 700 -100 -200 900 700 15 15
				//Смена
				hide			single_group
				hide			dual_group
				hide			saber2
				show			staff_group
				show			colorbut2
				show			box_color2
				//Переменные
				setcvar			ui_saber		"staff_1"
				setcvar			ui_saber2		""
				//Скрипты
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				uiScript  		"updatefightingstylechoices"
			}
		}
		
			//##############################
			//#		  ПОСОХОВЫЙ МЕЧ		   #
			//##############################
			

//ТЕКСТ: "ДВУХКЛИНОВЫЙ МЕЧ"
	itemDef 
		{
			name				typebut_staff
			group				staff_group
			text				@MENUS_SABERSTAFF
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			type				ITEM_TYPE_BUTTON
			textalign			ITEM_ALIGN_LEFT
			rect				120 20 200 30
			textstyle			3
			font				3
			textalignx			30
			textscale			1.1
			forecolor			1 1 1 1
			visible				0

		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  147 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
			play				"sound/interface/choose_saber.wav"
				//Смена
				show			single_group
				hide			dual_group
				hide			staff_group
				hide			box_color2
				hide			colorbut2
				//Перемещение	
				transition		saber			-200 -200 900 700 -200 -200 900 700 15 1
				//Переменные
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		""
				//Скрипты
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
			}	
		}
//----------------------------------------------------------------------------------------
//									МОДЕЛЬ МЕЧА
//----------------------------------------------------------------------------------------
//FIRST SABER
		itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-200 -125 900 700
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber				1
			model_angle			30
			model_rotation		20
			model_g2maxs		30 0 25
			model_fovx			50
			model_fovy			50
			visible				1
			decoration
		}
//SECOND SABER
		itemDef
		{
			name				saber2
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-200 -200 900 700
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber2			1
			model_angle			30
			model_rotation		20
			model_g2maxs		30 0 25
			model_fovx			50
			model_fovy			50
			visible				1
			decoration

			//cvarTest			ui_saber_type
			//hideCvar			{ "single" "staff" }

			decoration
		}
//----------------------------------------------------------------------------------------
//							   HILTS SINGLE
//----------------------------------------------------------------------------------------
//Коробка под текст: Нефисы	
	itemDef 
		{
			name				box_hilttype
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}	
//FIXME: read these from sabers.cfg + *.sab?
//Один меч
	itemDef 
		{
			name				hiltbut
			group				single_group
			text				@MENUS_HILT1
			descText			@MENUS_HILT1_DESC
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_LEFT

			
			//cvarTest			ui_saber_type
			//hideCvar			{ "staff" }

			cvar				"ui_saber"

			cvarStrList
			{
				@MENUS_SINGLE_HILT1 	"single_1"
				@MENUS_SINGLE_HILT2 	"single_2"
				@MENUS_SINGLE_HILT3 	"single_3"
				@MENUS_SINGLE_HILT4 	"single_4"
				@MENUS_SINGLE_HILT5 	"single_5"
				@MENUS_SINGLE_HILT6 	"single_6"
				@MENUS_SINGLE_HILT7 	"single_7"
				@MENUS_SINGLE_HILT8	 	"single_8"
				@MENUS_SINGLE_HILT9 	"single_9"
				"Inquisitor Single" 	"single_10"
			}
			visible				1	 
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  191 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber_hilt"
			}
		}	
