//----------------------------------------------------------------------------------------
// 			SABER CREATION MENU - called from main menu at the the start of a new game, 
//     and also when player is allowed to upgrade the fighting style and choose a new saber
//----------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberMenu"
		fullScreen				1					// MENU_TRUE				
		visible					1					// Visible on open
		focusColor				1 1 1 1				// Focus color for text and items	
	onOpen
		{	
		//Титутл
			transition			create_title	   -345   0 370 20 -25   0 370  20 18 18
		//Тип меча
			transition			box_typebut	  	   -345  15 342 30	-2  15 342  30 18 18
			transition			typebut		   	   -345  15 120 30	14  15 120  30 18 18
		//Одноручный меч
			transition			box_typebut_single -345  59 342 30  -2  59 342  30 18 18
			transition			typebut_single	   -345  75 120 30  86  75 120  30 18 18		
			transition			saberstyle	  	   -345 249 120 30  14 249 120  30 18 18
			transition			box_single_style   -345 235 342 30  -2 235 342  30 18 18
		//Двухрычный меч
			transition			box_typebut_dual   -345 103 342 30  -2 103 342  30 18 18	
			transition			typebut_dual	   -345 119 120 30 108 119 120  40 18 18	
		//Посох
			transition			box_typebut_staff  -345 147 342 30	-2 147 342  30 18 18	
			transition			typebut_staff	   -345 163 120 30  84 163 120  40 18 18	
		//Нефисы
			transition			box_hilttype	   -345 191 342 30	-2 191 342  30 18 18
			transition			hiltbut			   -345 205 120 30	14 205 120  40 18 18
			transition			hiltbut2		   -345 205 120 30  14 249 120  40 18 18
			transition			hiltbut_staves	   -345 205 120 30  14 205 120  40 18 18
		//Цвета
			transition			box_color1			640  15 342 30	340 15 298 	30 18 18
			transition			color_title			640   0 370 20  320  0 370  20 18 18
			transition			border_color		640  -2 298 17 	340 -2 298  17 18 18
			transition			box_color2			640  59 342 30	340 59 298 	30 18 18
			hide				box_color2
		//Назад
			transition			box_back	         -2 448 170  32	 -2 448 170  32 18 18
			transition			back			     55 450 120  24  55 450 120  24 18 18
		//Далее
			transition			box_next	   		168 448 170  32 168 448 170  32 18 18
			transition			next			    210 450 120  32 210 450 120  32	18 18
			transition			continue		    210 450 120  32 210 450 120  32	18 18
		//Лазерный меч
			transition			saber			  -200 -200 900 700	-200 -200 900 700 18 18 
		//Фон для меню
			transition			border_menu		   -345  -2 342 280	-2  -2   342.5 280.5 18 18
			*//
		//Переменные
			setcvar				"playersave" "(NULL)"
			setcvar				"tiers_complete" "(NULL)"
		//Подключение скриптов игры
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			uiScript  			"getsabercvars"
			uiScript  			"updatefightingstylechoices"
			uiScript  			"resetsabercvardefaults"
		}	
	onESC 
		{ 
			play				"sound/interface/esc.wav" 
			
			uiScript		 	"updatesabercvars"
			uiScript			closesabermenu		
		}
//----------------------------------------------------------------------------------------
//											ФОН МЕНЮ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				groundmenu
			group				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"menu/ground/MenuGround"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------
//   							ЗАТЕМНЕНЕНИЕ ФОНА
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------
// 									ВЫДЕЛЕНИЕ 
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				sidebutton_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			visible				0
			decoration
		}
//----------------------------------------------------------------------------------------
// 						МЕНЮ ВЫБОР ТИП МЕЧА
//----------------------------------------------------------------------------------------
//Бардюр под меню с левой сторны
	 itemDef 
		{
			name				border_menu
			group				none
			style				WINDOW_STYLE_FILLED
			rect				-2  -2 342.5 280.5
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
		}
//Коробка под текст "Тип меча"		
	itemDef 
		{
			name				box_typebut
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
//Текст :"Тип меча"
	itemDef 
		{
			name				typebut
			group				none
			text				@MENUS_SABER_TYPE
			style				WINDOW_STYLE_EMPTY
			rect				-2  15 342  44
			textalign			ITEM_ALIGN_LEFT	
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			visible				1
			textaligny			2			
			decoration
		}
//----------------------------------------------------------------------------------------
//									МОДЕЛЬ МЕЧА
//----------------------------------------------------------------------------------------
//FIRST SABER
		itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-200 -125 900 700
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber				1
			model_angle			30
			model_rotation		20
			model_g2maxs		30 0 25
			model_fovx			50
			model_fovy			50
			visible				1
			decoration
		}
//SECOND SABER
		itemDef
		{
			name				saber2
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-200 -200 900 700
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber2			1
			model_angle			30
			model_rotation		20
			model_g2maxs		30 0 25
			model_fovx			50
			model_fovy			50
			visible				1
			decoration

			cvarTest			ui_saber_type
			hideCvar			{ "single" "staff" }

			decoration
		}
//----------------------------------------------------------------------------------------
// 						ОДНОРУЧНЫЙ МЕЧ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				box_typebut_single
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
	itemDef 
		{
			name				box_single_style
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			rect				-2 235 340  40
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			decoration
		}
	itemDef 
		{
			name				typebut_single
			group				none
			text				@MENUS_SINGLESABER
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.549 .854 1 1
			textalign			ITEM_ALIGN_LEFT
			visible				1
			
			mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  59 342  44
			}
			mouseExit 
			{ 
				hide			sidebutton_glow
			}
			action 
			{
				show			box_single_style
				hide			colorbut2
				hide			box_color2
				
				play			"sound/interface/choose_saber.wav"
				
				setcvar			ui_saber_type	"single"
				exec            "playermodel player_2"
				uiScript  		"saber_type"
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		""
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				
				transition		border_menu			-2   -2 342.5 280.5 -2  -2 342.5 280.5	0 0		
				transition		saber				-200 -200 900 700 -200 -200 900 700 18 18
				
				uiScript  		"updatefightingstylechoices"
			}
		}

//----------------------------------------------------------------------------------------
// 							ДВУХРУЧНЫЙ МЕЧ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				box_typebut_dual
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
	itemDef 
		{
			name				typebut_dual
			group				none
			text				@MENUS_DUALSABERS
			descText			@MENUS_DUALSABERS_DESC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				32 152 160 16
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.549 .854 1 1
			textalign			ITEM_ALIGN_LEFT

			visible				1

			mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  103 342  44
			}
			mouseExit 
			{ 
				hide			sidebutton_glow
			}
			action 
			{
				show			box_single_style
				show			colorbut2
				show			box_color2
				
				play			"sound/interface/choose_saber.wav"
				setcvar			ui_saber_type	"dual"

				uiScript  		"saber_type"
				
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		"single_1"
				
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				
				transition		border_menu			-2   -2 342.5 280.5 -2  -2 342.5 280.5 0 0
				transition 		saber 				-200 -200 900 700 -200 -125 900 700 18 18
				transition		saber2				-200 -200 900 700 -200 -225 900 700 18 18 
				
				uiScript  		"updatefightingstylechoices"
			}
		}
//----------------------------------------------------------------------------------------
// 									ПОСОХ МЕЧ
//----------------------------------------------------------------------------------------
//Строка под текст	
	itemDef 
		{
			name				box_typebut_staff
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
//ТЕКСТ: "ДВУХКЛИНОВЫЙ МЕЧ"
	itemDef 
		{
			name				typebut_staff
			group				none
			text				@MENUS_SABERSTAFF
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				32 172 160 16
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.549 .854 1 1
			textalign			ITEM_ALIGN_LEFT
			visible				1

			mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  147 342  44
			}
			mouseExit 
			{ 
				hide			sidebutton_glow
			}
			action 
			{
				hide			box_single_style
				hide			box_color2
				hide			colorbut2
				
				play			"sound/interface/choose_saber.wav"
				setcvar			ui_saber_type	"staff"

				uiScript  		"saber_type"
				
				setcvar			ui_saber		"dual_1"
				setcvar			ui_saber2		""
				
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				
				transition		border_menu			-2 -2 342.5 280.5 -2 -2 342.5 236.5 0 0				
				transition		saber				-100 -200 900 700 -100 -200 900 700 18 18
				uiScript  		"updatefightingstylechoices"
			}
		}
//----------------------------------------------------------------------------------------
//							   HILTS SINGLE
//----------------------------------------------------------------------------------------
//Коробка под текст: Нефисы	
	itemDef 
		{
			name				box_hilttype
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}	
//FIXME: read these from sabers.cfg + *.sab?
//Один меч
	itemDef 
		{
			name				hiltbut
			group				none
			text				@MENUS_HILT1
			descText			@MENUS_HILT1_DESC
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_LEFT

			
			cvarTest			ui_saber_type
			hideCvar			{ "staff" }

			cvar				"ui_saber"

			cvarStrList
			{
				@MENUS_SINGLE_HILT1 	"single_1"
				@MENUS_SINGLE_HILT2 	"single_2"
				@MENUS_SINGLE_HILT3 	"single_3"
				@MENUS_SINGLE_HILT4 	"single_4"
				@MENUS_SINGLE_HILT5 	"single_5"
				@MENUS_SINGLE_HILT6 	"single_6"
				@MENUS_SINGLE_HILT7 	"single_7"
				@MENUS_SINGLE_HILT8	 	"single_8"
				@MENUS_SINGLE_HILT9 	"single_9"
				"Inquisitor Single" 	"single_10"
			}
			visible				1	 
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  191 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber_hilt"
			}
		}	
//----------------------------------------------------------------------------------------
//								СТИЛЬ МЕЧА
//----------------------------------------------------------------------------------------
		itemDef 
		{
			name				saberstyle
			group				stylebuttons
			text				@MENUS_SABERSTYLE
			descText			@MENUS_FIGHTINGSTYLE
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.95 .64 .37 1
			
			cvarTest			ui_saber_type
			showCvar			{ "single" }
		
			cvar				"ui_newfightingstyle"
			cvarStrList
			{
				@MENUS_COMBATSTYLEFAST     "0"
				@MENUS_COMBATSTYLEMEDIUM   "1"
				@MENUS_COMBATSTYLEHEAVY    "2"
			}
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  235 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			} 
		}
//----------------------------------------------------------------------------------------
//							   HILTS DUAL
//----------------------------------------------------------------------------------------
//ЭМФИС для второго меча
	itemDef 
		{
			name				hiltbut2
			group				none
			text				@MENUS_HILT2
			descText			@MENUS_HILT2_DESC
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY

			textstyle			4
			font				5
			textscale			0.7
			forecolor			.95 .64 .37 1
			textalign			ITEM_ALIGN_LEFT

			cvarTest			ui_saber_type
			showCvar			{ "dual" }		
			cvar				"ui_saber2"
			
//FIXME: read these from sabers.cfg + *.sab?
			cvarStrList
			{
				@MENUS_SINGLE_HILT1 	"single_1"
				@MENUS_SINGLE_HILT2 	"single_2"
				@MENUS_SINGLE_HILT3 	"single_3"
				@MENUS_SINGLE_HILT4 	"single_4"
				@MENUS_SINGLE_HILT5 	"single_5"
				@MENUS_SINGLE_HILT6 	"single_6"
				@MENUS_SINGLE_HILT7 	"single_7"
				@MENUS_SINGLE_HILT8 	"single_8"
				@MENUS_SINGLE_HILT9 	"single_9"
				"Inquisitor Single" 	"single_10"
			}
			visible				1	 
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  235 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				show			saberstyle
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber2_hilt"
			}
		}
//----------------------------------------------------------------------------------------
//							   HILTS STAFf
//----------------------------------------------------------------------------------------
// HILT BUTTON 1 - STAVES
		itemDef 
		{
			name				hiltbut_staves
			group				none
			text				@MENUS_HILT1
			descText			@MENUS_HILT1_DESC
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.95 .64 .37 1
			
			cvarTest			ui_saber_type
			hideCvar			{ "single"; "dual" }

			cvar				"ui_saber"
			//FIXME: read these from sabers.cfg + *.sab?
			cvarStrList
			{
				@MENUS_STAFF_HILT1 		"staff_1"
				@MENUS_STAFF_HILT2 		"staff_2"
				@MENUS_STAFF_HILT3 		"staff_3"
				@MENUS_STAFF_HILT4 		"staff_4"
				@MENUS_STAFF_HILT5 		"staff_5"
				"Inquisitor Helisaber" 	"staff_6"

			}
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2  191 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
			action 
			{
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber_hilt"
			}
		}
//----------------------------------------------------------------------------------------
//								ТИТУЛ ЦВЕТ МЕЧА
//----------------------------------------------------------------------------------------
//Бардюр под меню с левой сторны
	 itemDef 
		{
			name				border_color
			group				none
			style				WINDOW_STYLE_FILLED
			rect				340 -2 298 17
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
		}
//Титул Цвета меча	
	itemDef 
		{
			name				color_title
			group				none
			text				@MENUS_BLADE_COLOR
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			textalign			ITEM_ALIGN_LEFT
			rect				320 0 370 20
			textstyle			3
			textalignx			135
			textaligny			-5
			font				3
			textscale			0.9
			forecolor			.95 .64 .37 1
			visible			1
			decoration
		}
//Коробка под эконку "цвет меча1"		
	itemDef 
		{
			name				box_color1
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
//Коробка под эконку "цвет меча2"		
	itemDef 
		{
			name				box_color2
			group				none
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 0.8
			border				4
			bordersize			2
			bordercolor			0 0.5 1 0.4
			visible				0
			decoration
		}			
//----------------------------------------------------------------------------------------
//							ПЕРВЫЙ ЦВЕТ МЕЧА
//----------------------------------------------------------------------------------------
// COLOR 1 BUTTON
	itemDef 
		{
			name				colorbut
			group				none
			text				@MENUS_COLOR1
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				350 28 160 20
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.549 .854 1 1
			textalign			ITEM_ALIGN_LEFT
			visible				1
			
			cvar				"ui_saber_color"
		cvarStrList
			{
				"Red" 			"red"
				"Orange" 		"orange"
				"Yellow" 		"yellow"
				"Green" 		"green"
				"Blue" 			"blue"
				"Purple" 		"purple"
			}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		300  14 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
		action 
			{
				play			"sound/interface/choose_blade.wav"
				uiScript  		"saber_color"
			}
		}
// COLOR 2 BUTTON
		itemDef 
		{
			name				colorbut2
			group				none
			text				@MENUS_COLOR2
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				350 73 160 20
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.549 .854 1 1
			visible				0
	 
			cvarTest			ui_saber_type
			hideCvar			{ "single"; "staff" }

			cvar				"ui_saber2_color"
			cvarStrList
			{
				"Red 		"red"
				"Orange" 	"orange"
				"Yellow" 	"yellow"
				"Green" 	"green"
				"Blue" 		"blue"
				"Purple" 	"purple"
			}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		300  58 342  44
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				play			"sound/interface/choose_blade.wav"
				uiScript  		"saber2_color"
			}
		}
