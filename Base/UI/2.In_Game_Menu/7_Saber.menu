			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		action 
			{ 
				play			"sound/interface/esc.wav" 								
				close			all ; 
				open			characterMenu
			}
		}
//Коробка для next
	itemDef 
		{
			name				box_next
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
//Далее
	itemDef 
		{
			name				next
			text				@MENUS_BEGIN_GAME
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				1	
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		150 450 220 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	
		action 
			{ 

				uiScript 		"updatesabercvars"
				uiScript 		"updatefightingstyle"

				uiScript		startgame	
			}	  	  
		}
//При втором прохождение
	itemDef 
		{
			name				continue
			text				@MENUS_CONTINUE
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				210 450 120  32
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				0

			cvarTest			saber_menu
			showCvar			{ "1" }

		action 
			{ 
				uiScript 		"updatesabercvars"
				uiScript 		"updatefightingstyle"
				exec			"playermode" "player_2"
				close			all
				setcvar			tier_storyinfo		"13"
				open			ingameGotoTier
				setcvar			storyhead			"kyle"
// HACK We're expecting to go to a mission screen from here
				playvoice		"sound/chars/storyinfo/13.mp3"	
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		150 450 220 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
		}
