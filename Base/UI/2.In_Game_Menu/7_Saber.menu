//----------------------------------------------------------------------------------------
//Бардюр под меню с левой сторны
	 itemDef 
		{
			name				border_color
			style				WINDOW_STYLE_FILLED
			rect				340 -2 298 17
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
