//------------------------------------------------------------------------------------------------
//										 LOADGAME MENU 
//------------------------------------------------------------------------------------------------
//									     ***ВАЖНО*** 										  
//								Это имя нельзя изменить, его ищет код.
//	   		 Если он должен измениться, измените его также в UI_AdjustSaveGameListBox()		
//-----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"ingameloadMenu"
		fullScreen				0							// MENU_FALSE				
		rect					0 0 640 480					// Size and position of the menu
		visible					1							// Visible on open
		focusColor				1 1 1 1						// Focus color for text and items

	onOpen 
		{
			play 				"sound/interface/transition"
			uiScript			ReadSaveDirectory
			
			setitemcolor		load				forecolor					   1 1 1 0
			setitemcolor		back				forecolor					   1 1 1 0
			setitemcolor		delete				forecolor					   1 1 1 0
			setitemcolor		cheacpoint			forecolor					   1 1 1 0

			transition			load				 -2 -100 160  30  -2  0 160   30 15 15
			transition			delete			    158 -100 160  30 158  0 160   30 15 15
			transition			cheacpoint		    318 -100 200  30 318  0 200   30 15 15
			transition			back			    518 -100 121  30 518  0 121   30 15 15
			
			transition			backload			156  640 322 250 156 228 322 250 15 15
			transition			loadgamepic		    158 -230 320 200 158  30 320 200 15 15
			transition			loadgamelist		156  640 322 247 156 229 322 247 15 15
			transition			backloadgamepic	    156 -230 322 202 156  29 322 202 15 15
			
			fadein				load
			fadein				back
			fadein				delete
			fadein				cheacpoint
		}
	onESC 
		{ 
			play			"sound/interface/esc.wav" 					
			close			ingameloadMenu ;
			open			ingamemainMenu
		}
	onClose
		{
			play			"sound/interface/esc.wav"
			open			ingamemainMenu
		}
//----------------------------------------------------------------------------------------
// 									Blur
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				Blur
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"menu/ground/blur"
			forecolor			1 1 0.9 0.45
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//	                               СИНИЯ СТРОКА ДЛЯ МЕНЮ
//----------------------------------------------------------------------------------------------
//СКРИН ЗАГРУЗОЧНОГО ЭКРАНА	
	itemDef 
		{
			name				loadgamepic
			style				WINDOW_STYLE_FILLED
			rect				158 30 320 200			
			ownerdraw			236					//UI_ALLMAPS_SELECTION		
			forecolor			1 1 1 1
			visible				1 
			decoration 
		}
	itemDef 
		{
			name				backloadgamepic
			style				WINDOW_STYLE_FILLED
			rect				156 29 322 202	
			border				3
			bordersize			2
			bordercolor			1 1 1 1
			visible				1
			decoration
		}		
//ВЫДЕЛЕНИЕ
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			decoration
		}
//----------------------------------------------------------------------------------------------
//								ОСНОВНОЕ МЕНЮ СЛЕВОЙ СТОРОНЫ
//----------------------------------------------------------------------------------------------
//КНОПКА "ЗАГРУЗИТЬ"
	itemDef 
		{
			name				load
			group				textmenu
			text				@MENUS_LOAD_GAME
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1			
			textalignx			18
			textaligny			0
			cvarTest			ui_SelectionOK
			enableCvar			{ "1" }
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-2 0 160 30
			} 
		mouseExit 
			{ 
				hide			sidebutton_glow
			} 
		action 
			{ 
				play			sound/interface/button1.wav ;
				hide			glow ;
				uiScript		loadgame
			}
		}
//КНОПКА "УДАЛИТЬ"
	itemDef 
		{
			name				delete
			group				textmenu
			text				@MENUS_DELETE_GAME
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1			
			textalignx			28
			textaligny			0
			cvarTest			ui_SelectionOK
			enableCvar			{ "1" }
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		160 0 158 30
			} 
		mouseExit 
			{ 
				hide			sidebutton_glow
			} 
		action
			{ 
				play			sound/interface/button1.wav ;
				hide			glow ;
				uiScript		deletegame
			}
		}
//КОНТРОЛЬНАЯ ТОЧКА
	itemDef 
		{
			name				cheacpoint
			group				textmenu
			text				@MENUS_RESUME_MISSION
			text2				@MENUS_RESUME_MISSIONN
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1			
			textalignx			18
			textaligny			0
			text2alignx			118
			cvarTest			ui_SelectionOK
			enableCvar			{ "1" }
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		320 0 198 30
			} 
		mouseExit 
			{ 
				hide			sidebutton_glow
			} 
		action
			{ 
				play			"sound/interface/button1.wav" ; 
				hide			glow ;
				uiScript		loadAuto
			}
		}
//КНОПКА "НАЗАД"
	itemDef 
		{
			name				back
			group				textmenu
			text				@MENUS_BACK_CAPS
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1			
			textalignx			40
			textaligny			0
			cvarTest			ui_SelectionOK
			enableCvar			{ "1" }
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
			visible				1
		mouseEnter 
			{
				show			sidebutton_glow
				setitemrect		sidebutton_glow		520 0 118 30
			}
		mouseExit 
			{ 				
				hide				sidebutton_glow
			}	  	  
		action 
			{ 
				play			"sound/interface/esc.wav" 
				close			all ; 
				open			ingamemainMenu 
			}
		}
//----------------------------------------------------------------------------------------------
//   								LOAD GAME MENU specific stuff
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				backload
			style				WINDOW_STYLE_FILLED
			rect				156 228 322 250	
			bordersize			2
			border				1
			bordercolor			1 1 1 1
			backcolor			.1 .1	.6 .5
			decoration
			visible				1
		}
//СОХРАНЕНИЕ ИГР В ПРИВЕДЕННОМ СПИСКЕ
	itemDef 
		{
			name				loadgamelist
			rect				156 229 322.5 247
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			outlinecolor		1 1 1 0.5
			elementwidth		400
			elementheight		16
			font				4
			textstyle			5
			textaligny			10
			textscale			1.05
			forecolor			.95 .64 .37 1
			
			elementtype			LISTBOX_TEXT
			feeder				FEEDER_SAVEGAMES
			notselectable
			columns				2 2 200 0 600 0 0 //# кол., x лок. 1-го столбца, число 2, похоже, ничего не делает, третье - ширина столбца
			
			visible				1
		mouseEnter 
			{ 
				setitemcolor	loadgamelist bordercolor 1 1 1 1
			} 
		mouseExit 
			{ 
				setitemcolor	loadgamelist bordercolor 0 0 .8 1
			} 
		doubleclick
			{
				play			sound/interface/button1.wav
				uiScript		loadgame
			}
		action 
			{
				play			sound/interface/sub_select 
			}
		}
	itemDef 
		{
			name				redux
			group				redux
			text				"REDUX"
			rect				610 460 0 0
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 0.1 0.1 1
			visible				1
			decoration
		}
	}
}
