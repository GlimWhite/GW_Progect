	itemDef 
		{
			name				redux
			group				redux
			text				"REDUX"
			rect				610 460 0 0
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 0.1 0.1 1
			visible				1
