			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			font				5
			textscale			0.5				
			textalignx			85
			textaligny			5
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
			
