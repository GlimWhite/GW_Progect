//_______________________________________________________________________________________________
//
// 										SETUP MENU
//_______________________________________________________________________________________________
{
	menuDef 
	{	
		name						"setupMenu"
		fullScreen					1							
		visible						1						
		focusColor					1 0.2 0.2 1			
	onOpen 
		{
			uiScript					getvideosetup 
		
			hide						group_defaults
			hide						group_sound
			hide						group_graphics

			hide						ApplyChanges 
			hide						group_vidrestart 
			
			show						defaults
			show						group_screen
			show						group_menu
			show						group_screen
//*********************
// Кнопки в меню
//*********************	
			transition					border_setup	   80 57 480 0 80 57 480 412 15 15
		
//*********************
// Кнопки в меню
//*********************
			transition					Videobutton			 10 18 0 30   10 18 150 30 15 15
			transition					Graphicsbutton		160 18 0 30  160 18 160 30 15 15
			transition					Soundbutton			320 18 0 30  320 18 160 30 15 15
			transition					Defaultsbutton		480 18 0 30  480 18 150 30 15 15
			setitemrect					escapebutton		530 58 30 28  				
//*********************
		}
	onESC 
		{ 
			play						"sound/interface/esc.wav" 		
			defer						VideoSetup	videowarningMenu 
			close						all 
			open						ReduxMainMenu 
		}
//_______________________________________________________________________________________________
//
//									MENU SETUP/МЕНЮ НАСТРОЙКИ
//_______________________________________________________________________________________________
//********************
// Фон для меню
//********************		
	itemDef 
		{
			name				SetupBackGround
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Затемения фона
//********************	
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//********************
// Поля для настроек
//********************
	itemDef 
		{
			name				border_setup	
			group				group_menu
			style				WINDOW_STYLE_FILLED
			backcolor			0 0 .6 .5
			border				1
			bordercolor			0.5 0.5 0.5 0.5
			decoration	
		mouseEnter 			
			{ 	
				setitemcolor	border_setup		bordercolor			1 1 1 1
			}
		mouseExit 			
			{
				setitemcolor	border_setup		bordercolor			0.5 0.5 0.5 0.5
			}
		}
//********************
// Титул меню
//********************	
	itemDef 
		{
			name				setup_title
			group				group_menu
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			text				@MENUS_SETUP_OPTIONS
			rect				0 -2 640 22
			textalign			ITEM_ALIGN_CENTER		
			textalignx			320
			textaligny			3	
			font				5
			textscale			0.6
			forecolor			.95 .64 .37 1
			visible				1 
			decoration
		}
//********************
// Выделение текста
//********************	
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 1 1 1
			decoration
		}
//_______________________________________________________________________________________________
//
//									ОСНОВНОЕ КОНТЕКСТНОЕ МЕНЮ
//_______________________________________________________________________________________________
//********************
// Кнопка "Изображение"
//********************	
	itemDef 
		{
			name					videobutton	
			group					group_menu
			text					@MENUS_OPTIONS
			text2					@MENUS_SCREEN
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_SHADER
			textalign				ITEM_ALIGN_LEFT
			forecolor				.95 .64 .37 1
			font					5
			textscale				.45
			textalignx				40
			textaligny				4
			text2alignx				16
			text2aligny				12
			visible					1
			
			background				"BoxMenu"
			
		mouseEnter 			
			{ 	
				show				sidebutton_glow 
				setitemrect			sidebutton_glow		10 18 150  30
			}
		mouseExit 			
			{
				hide 				sidebutton_glow
			}
		action 
			{ 
				play				sound/interface/sub_select 
				defer				VideoSetup			videowarningMenu 
				uiScript			getvideosetup 	   	// Get video settings
					
			transition				border_setup	   	80  57 480  0  80 57 480 412 15 15
			setitemrect				escapebutton	    530 58 30 28 
				show				group_screen
				show				defaults
				
				hide				group_defaults	
				hide				group_sound
				hide				group_vidrestart
				hide				group_graphics
				hide				applyChanges  
			}
		}
//********************
// Кнопка "Графика"
//********************	
itemDef 
		{
			name					Graphicsbutton
			group					group_menu
			text					@MENUS_OPTIONS
			text2					@MENUS_GRAPHICS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_SHADER
			textalign				ITEM_ALIGN_LEFT
			forecolor				.95 .64 .37 1
			font					5
			textscale				.45
			textalignx				46
			textaligny				4
			text2alignx				9
			text2aligny				12
			visible					1
			
			background				"BoxMenu"
			
		mouseEnter
			{ 
				show				sidebutton_glow ; 	
				setitemrect			sidebutton_glow 		160 18 160  30
			}
		mouseExit 		
			{ 
				hide 				sidebutton_glow 
			}
		action 
			{ 
				play				sound/interface/sub_select 
				defer				VideoSetup	videowarningMenu 	
				
				transition			border_setup	   10 57 620 0 10 57 620 412 15 15
				setitemrect			escapebutton	   600 58 30 28
				show				group_graphics
				show				defaults
				
				hide				group_screen
				hide				group_defaults	
				hide				group_sound
				hide				group_vidrestart
				hide				applyChanges  			
			}
		}
//********************
// Кнопка "Звук"
//********************	
	itemDef 
		{
			name					soundbutton	
			group					group_menu
			text					@MENUS_OPTIONS
			text2					@MENUS_SOUNDED
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_SHADER
			textalign				ITEM_ALIGN_LEFT
			forecolor				.95 .64 .37 1
			font					5
			textscale				.45
			textalignx				46
			textaligny				4
			text2alignx				19
			text2aligny				12
			visible					1
			
			background				"BoxMenu"
			
		mouseEnter
			{ 
				show				sidebutton_glow 	
				setitemrect			sidebutton_glow 	320 18 160  30
			}
		mouseExit 		
			{ 
				hide 				sidebutton_glow 
			}
		action 
			{ 
				play				sound/interface/sub_select 
				defer				VideoSetup			videowarningMenu 	
				
				transition			border_setup	  	80 57 480 0 80 57 480 412 15 15
				setitemrect			escapebutton	    530 58 30 28
				show				group_sound
				
				hide				group_graphics
				hide				group_screen
				hide				group_defaults	
				hide				defaults
				hide				group_vidrestart
				hide				applyChanges
			}
		}
//********************
// Кнопка "Выйти"
//********************	
	itemDef
		{
			name					escapebutton
			group					group_menu
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_FILLED
			background				"Escape"
			border					1
			bordercolor				0.5 0.5 0.5 1
			visible					0		
		mouseEnter 			
			{
				setitemcolor		escapebutton	bordercolor	1 1 1 1	
			}
		mouseExit 			
			{ 
				setitemcolor		escapebutton	bordercolor	0.5 0.5 0.5 0.5	
			}
		action 
			{ 
				play				"sound/interface/esc.wav"
				close				all
				open				ReduxMainMenu				
			}
		}
//_______________________________________________________________________________________________
//
//							MENU SCREEEN/ МЕНЮ ЭКРАН (НАСТРОЙКА ЭКРАНА)
