		{
			name				default_yes
			group				group_defaults
			text				@MENUS_YES
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				185 300 60 30
			textalign			ITEM_ALIGN_LEFT
			font 				5
			textscale 			0.6
			textalignx			20
			textaligny			8
			forecolor			.95 .64 .37 1
			
			background			"menu/box_redux"
		mouseEnter
			{
				show				sidebutton_glow
				setitemrect			sidebutton_glow			185 300 60 30
			}
		mouseExit	
			{
				hide				sidebutton_glow
			}			
		action 
			{ 
				play			"sound/interface/button1.wav" 
				close			all  
				uiscript		resetdefaults
			}	  	  
		}
//**************
// Кнопка "Нет"
//**************
	itemDef 
		{
			name				default_no
			group				group_defaults
			text				@MENUS_NO
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				415 300 60 30
			textalign			ITEM_ALIGN_LEFT
			font				5
			textscale 			0.6
			textalignx			17
			textaligny			8
			forecolor			.95 .64 .37 1

			background			"menu/box_redux"	
		mouseEnter
			{
				show				sidebutton_glow
				setitemrect			sidebutton_glow			415 300 60 30
			}
		mouseExit	
			{
				hide				sidebutton_glow
			}			
		action 
			{ 
				play			"sound/interface/esc.wav" 
				uiscript 		clearmouseover	default_no 
				close			all  
				open			ReduxMainMenu 
			}	
		}
