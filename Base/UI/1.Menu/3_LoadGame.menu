//------------------------------------------------------------------------------------------------
//										 LOADGAME MENU 
//------------------------------------------------------------------------------------------------
//									     ***ВАЖНО*** 										  
//								Это имя нельзя изменить, его ищет код.
//	   		 Если он должен измениться, измените его также в UI_AdjustSaveGameListBox()		
//-----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"loadgameMenu"
		visible					1
		fullScreen				1
		focusColor				1 1 1 1	
	onESC 
		{ 
			play				"sound/interface/esc.wav" 
			close				all
			open				ReduxMainMenu
		}
	onOpen
		{
			uiScript			ReadSaveDirectory ;
			
			show				textmenu
			setitemcolor		textmenu 			forecolor			.95 .64 .37 0
			fadein				textmenu
			
			transition			border_load			640 198 460 280 	180 198 459 280	 	6 8	
			transition			border_text_menu   -183  -3 185 483		 -3  -3 185 483		6 8	
			transition			border_screan		640  -1 459 200		180  -1 459 200		6 8	
			transition			border_academy	   -183   5 185  60		 -3  -3 185  70		6 8	
			
			transition			academy			   -180   5 175  60		  3   5 175  60		6 8	
			
			transition			loadgamelist		640 198 457 278		182 198 458 282		6 8 
			transition			loadgamepic			640   0 460 200		183   0 460 200		6 8
		}
//----------------------------------------------------------------------------------------------
//	                                      ФОН МЕНЮ
//----------------------------------------------------------------------------------------------
//ФОН МЕНЮ
	itemDef 
		{
			name				groundmenu
			group				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"menu/ground/MenuGround"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------
//   							ЗАТЕМНЕНЕНИЕ ФОНА
//----------------------------------------------------------------------------------------
	
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//	                               СИНИЯ СТРОКА ДЛЯ МЕНЮ
//----------------------------------------------------------------------------------------------

//ВЫДЕЛЕНИЕ
	itemDef 
		{
			name				sidebutton_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			decoration
		}
//СИИНЙ БАРДЮР ДЛЯ ТЕКСТА МЕНЮ
	 itemDef 
		{
			name				border_text_menu
			group				menu
			style				WINDOW_STYLE_SHADER
			rect				-3 -3 185 483
			background			"bordermenu"		
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			border				1
			bordersize			2
			bordercolor			0.2 0.2 1 0.5
			decoration
		}
	 itemDef 
		{
			name				border_academy
			group				border_academy
			style				WINDOW_STYLE_FILLED
			rect				-3 -3 185 70	
			forecolor			1 1 1 1
			visible				1
			border				2
			bordersize			2
			bordercolor			0.2 0.2 1 0.5
			decoration
		}
//TEXT ACADEMY
	itemDef 
		{
			name				academy
			group				academy
			style				WINDOW_STYLE_SHADER
			rect				3 5 175 60
			background			"menu/interface/academy"
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//	                               МЕНЮ ДОБАВЛЕНИЕ СТРЕЛКИ
//----------------------------------------------------------------------------------------------
	itemDef 
		{
			name				dp1
			group				dp_arrow
			style				WINDOW_STYLE_SHADER
			rect				5 180 15 15
			background			"menu/dp_arrow_r"		
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				dp2
			group				dp_arrow
			style				WINDOW_STYLE_SHADER
			rect				5 230 15 15
			background			"menu/dp_arrow_r"		
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				dp3
			group				dp_arrow
			style				WINDOW_STYLE_SHADER
			rect				5 280 15 15
			background			"menu/dp_arrow_r"		
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				dp4
			group				dp_arrow
			style				WINDOW_STYLE_SHADER
			rect				5 430 15 15
			background			"menu/dp_arrow_r"		
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//----------------------------------------------------------------------------------------------
//								ОСНОВНОЕ МЕНЮ СЛЕВОЙ СТОРОНЫ
//----------------------------------------------------------------------------------------------
//ВЫДЕЛЕНИЕ СТРОК МЕНЮ
	itemDef 
		{
			name				dp
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 15 15
			background			"menu/dp_arrow_ron"
			forecolor			1 1 1 1
			visible				0
			decoration
		}
//КНОПКА "ЗАГРУЗИТЬ"
	itemDef 
		{
			name				loadgameaction
			group				textmenu
			text				@MENUS_LOAD
			style				WINDOW_STYLE_EMPTY
			rect				30 180 60 20
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				5
			textscale			0.7
			forecolor			.95 .64 .37 1
			visible				0
			cvarTest			ui_SelectionOK
			enableCvar			{ "1" }
		mouseEnter 
			{ 
				show 			dp
				setitemrect		dp				 	 5 180 15 15
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-20 165 200 40
			} 
		mouseExit 
			{ 
				hide			dp
				hide			sidebutton_glow
			} 
		action 
			{ 
				play			sound/interface/button1.wav ;
				uiScript		loadgame
			}
		}
//КНОПКА "УДАЛИТЬ"
	itemDef 
		{
			name				deletegamebutton
			group				textmenu
			text				@MENUS_DELETE_GAME
			style				WINDOW_STYLE_EMPTY
			rect				30 230 130 24
			font				5
			textscale			0.7
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			.95 .64 .37 1
			visible				0
			cvarTest			ui_SelectionOK
			enableCvar			{ "1" }
		mouseEnter 
			{ 
				show 			dp	
				setitemrect		dp				  	5 230 15 15
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-20 215 200 40
			} 
		mouseExit 
			{ 
				hide			dp
				hide			sidebutton_glow
			} 
		action
			{ 
				play			sound/interface/button1.wav ;
				uiScript		deletegame
			}
		}
//КОНТРОЛЬНАЯ ТОЧКА
	itemDef 
		{
			name				resumeautobutton
			group				textmenu
			text				@MENUS_RESUME_MISSION
			text2				@MENUS_RESUME_MISSIONN
			style				WINDOW_STYLE_EMPTY
			rect				30 280 150 30
			font				5
			textscale			0.7
			textalign			ITEM_ALIGN_LEFT
			text2alignx			40
			text2aligny			20
			textstyle			3
			forecolor			.95 .64 .37 1
			visible				0					// This button isn't used when not in game.
			cvarTest			ui_ResumeOK
			enableCvar			{ "1" }
		mouseEnter 
			{ 
				show			dp
				setitemrect		dp				 	 5 280 15 15
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-20 265 200 40
			} 
		mouseExit 
			{ 
				hide			dp
				hide			sidebutton_glow
			} 
		action
			{ 
				play			"sound/interface/button1.wav" ; 
				uiScript		loadAuto
			}
		}
//КНОПКА "НАЗАД"
	itemDef 
		{
			name				backbutton
			group				textmenu
			text				@MENUS_BACK_CAPS
			style				WINDOW_STYLE_EMPTY
			rect				30 430 150 30
			font				5
			textscale			0.7
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			forecolor			.95 .64 .37 1
			enableCvar			{ "1" }
			visible				0
		mouseEnter 
			{ 
				show			dp 					 
				setitemrect		dp					 5	430	15	15
				show			sidebutton_glow
				setitemrect		sidebutton_glow		-20 415 200 40
			}
		mouseExit 
			{ 
				hide				dp
				hide				sidebutton_glow
			}			
		action 
			{ 
				play			"sound/interface/esc.wav" 
				close			all ; 
				open			ReduxMainMenu 
			}
		}
//----------------------------------------------------------------------------------------------
//   								LOAD GAME MENU specific stuff
//----------------------------------------------------------------------------------------------
//СОХРАНЕНИЕ ИГР В ПРИВЕДЕННОМ СПИСКЕ
	itemDef 
		{

			name				loadgamelist
			group				none
			rect				183 205 457 280
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED	
			elementwidth		400
			elementheight		16
			font				4
			textaligny			10
			textscale			1.05
	//БАРДЮР
			//bordersize			1
			//bordercolor			0 0 .8 1
			forecolor			.549 .854 1 1
			backcolor			0 0 .5 .25
			outlinecolor		.5 .5 .5 .5
			elementtype			LISTBOX_TEXT
			feeder				FEEDER_SAVEGAMES
			notselectable
			visible				1
			columns				2 2 200 200 280 200 160 //# кол., x лок. 1-го столбца, число 2, похоже, ничего не делает, третье - ширина столбца
		mouseEnter 
			{ 
				setitemcolor	loadgamelist bordercolor 1 1 1 1
			} 
		mouseExit 
			{ 
				setitemcolor	loadgamelist bordercolor 0 0 .8 1
			} 
		doubleclick
			{
				play			sound/interface/button1.wav
				uiScript		loadgame
			}
		action 
			{
				play			sound/interface/sub_select 
			}
		}
//СКРИН ЗАГРУЗОЧНОГО ЭКРАНА	
	itemDef 
		{
			name				loadgamepic
			group				none
			style				WINDOW_STYLE_EMPTY
			rect				183 2 460 200			
			ownerdraw			236					//UI_ALLMAPS_SELECTION		
			forecolor			1 1 1 1
			visible				1 
			decoration 
		}
	}
}