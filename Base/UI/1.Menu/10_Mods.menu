//----------------------------------------------------------------------------------------
//							New Menu MODS/ Новое Меню Моды
//----------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"ModsMenu"
		fullScreen				1					// MENU_TRUE				
		visible					1					// Visible on open
		focusColor				1 1 1 1				// Focus color for text and items	
	onOpen
		{	
			uiScript			loadMods 
			defer				VideoSetup		videowarningMenu 
				
			transition			mods_list	 	20  40 580 0  20  40 580 390 15 15
			transition			mods_load	 	20 430 580 0  20 430 580  25 15 15	
			transition			Escape			600 21  20 0 600  21  21  20 15 15 
			transition			BorderMenu		20	20 600 0  20  20 600 430 15 15
		}	
	onESC 
		{ 
			play				"sound/interface/esc.wav" 
			close				all
			Open				ReduxMainMenu	
		}
//----------------------------------------------------------------------------------------
//	MENU MODS/ МЕНЮ МОДЫ
//----------------------------------------------------------------------------------------
//********************
// Фон меню
//********************
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Затемнения фона
//********************
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			visible				1
			decoration
		}
//********************
// Фон для листа модов
//********************
	itemDef 
		{
			name				bordermenu
			style 				WINDOW_STYLE_FILLED
			backcolor			.03 .12 0.8 0.4
			visible				1
			decoration
		}
//********************
// Выделение текста
//********************
	itemDef 
		{
			name				sidebutton_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"menu/menu_blendbox"
			forecolor			1 0 0 0.5
			visible				0
			decoration
		}
//********************
// Окно с модами
//********************
	itemDef 
		{
			name				mods_list
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			elementwidth		120
			elementheight		16
			font				3
			textscale			1
			
			forecolor			.79 .64 .22 1		
			outlinecolor		.5 .5 .5 .5
			elementtype			LISTBOX_TEXT
			
			feeder				9
			notselectable
			visible				0
//			columns				2 2 40 280
		}
//*************************
// Кнопка "Загрузить моды"
//*************************
	itemDef 
		{
			name				loadmod
			group				mods_load
			text				@MENUS_LOAD_MOD
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			textalign			ITEM_ALIGN_LEFT	
			font				5
			textscale			0.5			
			textalignx			250
			textaligny			6
			forecolor			1 0.1 0.1 1	
			
			visible				0
		action 
			{ 
				play			"sound/interface/button1.wav"
				uiScript		RunMod 
			}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		20 430 600 25
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		}
//********************************
//  Кнопка для закрытия окна "X"
//********************************
	itemDef
		{
			name					Escape
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_FILLED
			background				"Escape"
			forecolor				1 1 1 1
			border					1
			bordercolor				1 1 1 1
			visible					0		
		mouseEnter 			
			{
				setitemcolor		Escape 	forecolor	1 0 0 1
				setitemcolor		Escape	bordercolor	1 0 0 1	
			}
		mouseExit 			
			{ 
				setitemcolor		Escape	focusColor	1 1 1 1 
				setitemcolor		Escape	bordercolor	1 1 1 1	
			}
		action 
			{ 
				play				"sound/interface/esc.wav"
				
				transition			mods_list	 	200  15 430 435	680  15 430 435 15 15
				transition			mods_load	 	 25	200 450 430 680	200 450 430 15 15
				transition			Escape			613  15  15  15	680  15  15  15 15 15 

				show				allmenu				
			}
		}
//__________________________________________
//
//			ЭЛЕМЕНТЫ ВЫШЕ ДРУГИХ
//__________________________________________
//
//********************
// Текст "REDUX"
//********************	
	itemDef 
		{
			name				redux
			group				redux
			text				"REDUX"
			rect				615 468 0 0
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Шапка меню
//********************
	itemDef 
		{
			name				create_title
			group				title
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			text				@MENUS_LIGHTSABER_CREATION
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			textalignx			115
			textaligny			-5
			font				3
			textscale			0.9
			forecolor			.95 .64 .37 1
			visible				1 
			decoration 
		}
	}
}
