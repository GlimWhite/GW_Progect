//___________________________________________________________________________________________
//	
//								QUIT MENU/ Меню выхода
//___________________________________________________________________________________________
{
	menuDef 
	{
		name					"QuitMenu"			// Название
		fullScreen				1					// Размер по всему экрану
		focusColor				1 1 1 1				// Изменеие выделение цвета в меню
		visible					1					// ВидимостьR		
	onESC 
		{ 
			play				"sound/interface/esc.wav" 					
			close				quitMenu ; 
			open				ReduxMainMenu ;
		}
	onOpen 
		{
			setfocus			quitgame_cancel
		}
//___________________________________________________________________________________________
//
//									ОСНОВНОЕ МЕНЮ
//___________________________________________________________________________________________		
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			visible				1
			decoration
		}
//********************
// Затемнения фона
//********************	
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//********************
// Затемнения фона
//********************	
	itemDef 
		{
			name				boxMenu
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			rect				120 150 410 220
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//*************************************
// Текст: "Покинуть Академию джедаев?"
//*************************************	
	itemDef 
		{
			name 				confirm
			group				none
			text 				@MENUS_QUIT_JEDI_KNIGHT_II
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			rect 				160 180 330 40
			font				5
			textscale 			0.75
			textalign 			ITEM_ALIGN_CENTER
			textalignx	 		160
			textaligny			10
			forecolor			.95 .64 .37 1
			border				4
			bordercolor			1 1 1 1
			visible 			1
			decoration
		}
//********************
// Текст: "Нет"
//********************			
	itemDef 
		{
			name				quitgame_no
			text				@MENUS_NO
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			rect				403 300 60 25
			font				5
			textscale			0.65
			textalignx			14
			textaligny			5
			textalign			ITEM_ALIGN_LEFT
			forecolor			.95 .64 .37 1
			border				4
			bordersize			1
			visible				1
		action 
			{ 
				play			"sound/interface/esc.wav" 					
				close			quitMenu ; 
				open			ReduxMainMenu ;
			}	  	  
		}
//********************
// Текст: "Да"
//********************	
	itemDef 
		{
			name				quitgame_yes
			text				@MENUS_YES
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			rect				200 300 60 25
			font				5
			textscale			0.65
			textalignx			18
			textaligny			4
			textalign			ITEM_ALIGN_LEFT
			forecolor			.95 .64 .37 1
			border				4
			bordersize			1
			visible				1
		action 
			{ 
				play			"sound/interface/button1.wav" ; 
				uiScript		Quit			
			}	  	  
		}
//___________________________________________________________________________________________
//
//										ЭЛЕМЕНТЫ В МЕНЮ ВЫШЕ ДРУГИХ
//___________________________________________________________________________________________		
	itemDef 
		{
			name				redux
			text				"REDUX"
			rect				615 468 0 0
			font				5
			textscale			0.5
			textaligny			1
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	itemDef 
		{
			name				academy
			group				none
			style				WINDOW_STYLE_SHADER
			rect				220 -1 200 75
			background			"academy"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
	}
}

















