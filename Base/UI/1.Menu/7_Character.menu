	itemDef 
		{
			name				legsbut
			group				none
			text				@MENUS_LEGS
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textstyle			4
			font				5
			textscale			0.7
			forecolor			.549 .854 1 1
			visible				1
			 
			mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		-15 363 340 30
			}
			mouseExit 
			{ 
