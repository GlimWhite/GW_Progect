//----------------------------------------------------------------------------------------
//								ПЕРЕМЕЩЕНИЕ В МЕНЮ
//----------------------------------------------------------------------------------------
	itemDef 
		{
			name				box_back
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
//Назад	
	itemDef 
		{
			name				backbutton
			group				exit
			text				@MENUS_BACK_CAPS
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		-30 450 220 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		action 
			{ 
				play			"sound/interface/esc.wav" 								
				close			all ; 
				open			newgamefirstMenu 
			}
		}
	itemDef 
		{
			name				box_next
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			bordercolor			0 0.5 1 0.4
			visible				1
			decoration
		}
//Далее
	itemDef 
		{
			name				next
			group				none
			text				@MENUS_NEXT
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				1
		action 
			{ 
				play			"sound/interface/button1.wav" 
				close			all 
				uiScript 		"updatecharcvars"
				setcvar			saber_menu  0
				setcvar			ui_saber_type  single
				open			saberMenu 
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		150 450 220 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
		}	
//----------------------------------------------------------------------------------------
//								ЭЛЕМЕНТЫ ВЫШЕ ДРУГИХ
//----------------------------------------------------------------------------------------	
	itemDef 
		{
			name				redux
			group				redux
			text				"REDUX"
			rect				615 468 0 0
			font				5
			textscale			0.5
			textalign			ITEM_ALIGN_CENTER
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//ТИТУТЛ
	itemDef 
		{
			name				create_title
			group				title
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			text				@MENUS_CHARACTER_CREATION
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			textalignx			115
			textaligny			-5
			font				3
			textscale			0.9
			forecolor			.95 .64 .37 1
			visible				1 
			decoration 
		}
	}
