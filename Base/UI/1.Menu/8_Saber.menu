//----------------------------------------------------------------------------------------
// 			SABER CREATION MENU - called from main menu at the the start of a new game, 
//     and also when player is allowed to upgrade the fighting style and choose a new saber
//----------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberMenu"
		fullScreen				1				
		visible					1					
		focusColor				1 1 1 1					
	onOpen
		{	
		//Перемещение
			transition			create_title_saber	  0  10   0 30   0  10 220  30 15 15	//Титул создание меча
			transition			typebut		   	      0  40   0 30   0  40 120  30 15 15	//Текст "Тип меча"
			transition			saberstyle_text		  0 120   0 30   0 120 120  30 15 15	//Стиль боя - "Название"
			transition			hilt_single_text	  0  80   0 30   0  80 120  30 15 15 	//Текст: Рукоять
			transition			typebut_single		120  40   0 30 120  40 200  30 15 15	//Текст "Одиночный меч"
			transition			hilt_single		   	120  80   0 30 120  80 200  30 15 15 	//Рукоять - Одноручный
			transition			hilt_staff	   	    120  80   0 30 120  80 200  30 15 15	//Рукоять - Посох
			transition			hilt_dual		   	120 120   0 30 120 120 200  30 15 15 	//Рукоять - Двуручный
			transition			saberstyle			120 120   0 30 120 120 200  30 15 15	//Стиль боя - "Название"
			
			transition			color_title			340  10   0 30 340  10 220  30 15 15	//Титул Цвета
			transition			color_set_text		340  40   0 30 340  40 120  30 15 15	//Текст "Цвет"
			transition			colorbut			460  40   0 30 460  40 180  30 15 15 	//Выбор Цвета
			transition			color_set_text2		340  80   0 30 340  80 120  30 15 15	//Текст "Цвет2"
			transition			colorbut2			460  80   0 30 460  80 180  30 15 15 	//Выбор Цвета
			
			transition			border_menu			  0   0 640  0   0   0 640 160 15 15  	//Фон для текста
			transition			back			      0 450   0 30   0  450 120 30 15 15	//Кнопка "Назад"
			transition			next			    520 450   0 30 520  450 120 30 15 15	//Кнопка "Вперед"
			transition			continue		    520 450   0 30 520  450 120 30 15 15	//Кнопка "Продолжить"

			setitemrect			saber			   -300 -250 950 700						//Меч		
		//Переменные
			setcvar				"playersave" "(NULL)"
			setcvar				"tiers_complete" "(NULL)"
		//Подключение скриптов игры
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			uiScript  			"getsabercvars"
			uiScript  			"updatefightingstylechoices"
			uiScript  			"resetsabercvardefaults"
		//Скрыть элементы
			hide				typebut_dual
			hide				typebut_staff
			hide				hilt_dual
			hide				hilt_staff
			hide				saber2
			hide				hilt_single_text2
			hide				color_set_text2
			hide				colorbut2
		//Показать элементы	
			show				typebut_single
			show				hilt_single
			show				saberstyle_text
			show				saberstyle
		}	
	onESC 
		{ 
			play				"sound/interface/esc.wav" 
			
			uiScript		 	"updatesabercvars"
			uiScript			closesabermenu		
		}
//_______________________________________________________________________________________________
//
//								ЭЛЕМЕНТЫ МЕНЮ
//_______________________________________________________________________________________________
//*********
// Фон меню
//*********
itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				-10 -5 650 485
			background			"groundmenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//*********
// Фон для текста
//*********
	 itemDef 
		{
			name				border_menu
			style				WINDOW_STYLE_FILLED
			rect				-2  -2 342.5 280.5
			backcolor			0 0 .6 .5
			forecolor			0 0 1 1
			border				1
			bordercolor			1 1 1 0.5
			bordersize			2
			visible				1
			decoration
			decoration
		}
//*********
// BLUR
//*********
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//_______________________________________________________________________________________________
//
//								ВЫБОР ТИП МЕЧА В МЕНЮ
//_______________________________________________________________________________________________
			//##############################
			//#		  МОДЕЛЬ МЕЧА 1		   #
			//##############################
		itemDef
		{
			name				saber
			type 				ITEM_TYPE_MODEL
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber				1
			model_rotation		45
			model_g2maxs		30 0 25
			model_fovx			50
			model_fovy			50
			visible				1
			decoration
		}
			//##############################
			//#		  МОДЕЛЬ МЕЧА 2		   #
			//##############################
		itemDef
		{
			name				saber2
			type 				ITEM_TYPE_MODEL
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber2			1
			model_rotation		45
			model_g2maxs		30 0 25
			model_fovx			50
			model_fovy			50
			visible				1
			decoration

			decoration
		}
//*********
// Титул создание меча
//*********
	itemDef 
		{
			name				create_title_saber
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			text				@MENUS_LIGHTSABER_CREATION
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			textalignx			10
			font				3
			textscale			1.1
			forecolor			1 1 1 1
			visible				1 
			decoration 
		}
//*********
//Текст :"Тип меча"
//*********
	itemDef 
		{
			name				typebut
			text				@MENUS_SABER_TYPE
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT	
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			background			"BoxMenu"	
			visible				1
			
			decoration
		}

			//##############################
			//#		  ОДНОРУЧНЫЙ МЕЧ	   #
			//##############################
			
	itemDef 
		{
			name				typebut_single
			text				@MENUS_SINGLESABER
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			type				ITEM_TYPE_BUTTON
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textalignx			10
			textscale			1.1
			forecolor			0.5 1 0.1 1
			visible				1
			
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		0 40 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
			play				"sound/interface/choose_saber.wav"
				//Переменные
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		"single_1"
				//Перемещение
				transition 		saber 			-300 -250 950 700 -300 -300 950 700 15 15
				transition		saber2			-300 -250 950 700 -300 -150 950 700 15 15 
				//Смена
				hide			typebut_single
				show			typebut_dual
				hide			typebut_staff
				
				show			hilt_single_text2
				show			hilt_single
				show			hilt_dual
				hide			hilt_staff
				hide			saberstyle_text
				hide			saberstyle
				show			color_set_text2
				show			colorbut2
				
				//Скрипт
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				uiScript  		"updatefightingstylechoices"
				exec            "playermodel player_2"
			}
		}

			//##############################
			//#		  ДВУХРУЧНЫЙ МЕЧ	   #
			//##############################
			

	itemDef 
		{
			name				typebut_dual
			text				@MENUS_DUALSABERS
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			type				ITEM_TYPE_BUTTON
			textalign			ITEM_ALIGN_LEFT
			rect				120 40 200 30
			textstyle			3
			font				3
			textalignx			10
			textscale			1.1
			forecolor			0.5 1 0.1 1
			visible				0

		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		0 40 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
			play				"sound/interface/choose_saber.wav"
				//Перемещение
				setitemrect		saber			-80 -150 800 600
				//Смена
				hide			typebut_single
				hide			typebut_dual
				hide			saber2
				hide			hilt_single_text2

				hide			hilt_single
				hide			hilt_dual
				show			hilt_staff
				
				show			typebut_staff
				show			colorbut2
				
				hide			color_set_text2
				hide			colorbut2
				//Переменные
				setcvar			ui_saber		"staff_1"
				setcvar			ui_saber2		""
				//Скрипты
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				uiScript  		"updatefightingstylechoices"
			}
		}
		
			//##############################
			//#		  ПОСОХОВЫЙ МЕЧ		   #
			//##############################
			

//ТЕКСТ: "ДВУХКЛИНОВЫЙ МЕЧ"
	itemDef 
		{
			name				typebut_staff
			text				@MENUS_SABERSTAFF
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			type				ITEM_TYPE_BUTTON
			textalign			ITEM_ALIGN_LEFT
			rect				120 40 200 30
			textstyle			3
			font				3
			textalignx			10
			textscale			1.1
			forecolor			0.5 1 0.1 1
			visible				0

		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		0 40 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}
		action 
			{
			play				"sound/interface/choose_saber.wav"
				//Смена
				show			typebut_single
				hide			typebut_dual
				hide			typebut_staff
				
				show			hilt_single
				hide			hilt_dual
				hide			hilt_staff
				show			saberstyle_text
				show			saberstyle
				
				hide			color_set_text2
				hide			colorbut2
				
				//Перемещение	
				setitemrect		saber			-300 -250 950 700
				//Переменные
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		""
				//Скрипты
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
			}
		}			
