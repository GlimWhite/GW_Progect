//_______________________________________________________________________________________________
//		
//FIXME: read these from sabers.cfg + *.sab
//

			//###################################
			//		РУКОЯТЬ ОДНОРУЧНЫЙ МЕЧ	    #
			//###################################
			
//****************
// Текст: Рукоять
//****************
	itemDef 
		{
			name				hilt_single_text
			text				@MENUS_HILT_NEW
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			
			textalign			ITEM_ALIGN_LEFT
			rect				0 80 120 30
			visible				1
			decoration
		}	
//****************
// Текст: Рукоять (2)
//****************		
	itemDef 
		{
			name				hilt_single_text2
			text				@MENUS_HILT_NEW2
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			textalign			ITEM_ALIGN_LEFT
			rect				0 120 120 30
			visible				1
			decoration
		}
//****************
// Лист Рукоятей
//****************
	itemDef 
		{
			name				hilt_single
			text				" "
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			0.5 1 0.1 1
			textalign			ITEM_ALIGN_LEFT

			cvar				"ui_saber"

			cvarStrList
			{
				@MENUS_SINGLE_HILT1 	"single_1"
				@MENUS_SINGLE_HILT2 	"single_2"
				@MENUS_SINGLE_HILT3 	"single_3"
				@MENUS_SINGLE_HILT4 	"single_4"
				@MENUS_SINGLE_HILT5 	"single_5"
				@MENUS_SINGLE_HILT6 	"single_6"
				@MENUS_SINGLE_HILT7 	"single_7"
				@MENUS_SINGLE_HILT8	 	"single_8"
				@MENUS_SINGLE_HILT9 	"single_9"
				"Inquisitor Single" 	"single_10"
			}
			visible				1	 
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow			0 80 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber_hilt"
			}
		}	
			//###################################
			//#		РУКОЯТЬ ДВОЙНОЙ МЕЧ	    	#
			//###################################
	itemDef 
		{
			name				hilt_dual
			text				" "
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"

			textstyle			3
			font				3
			textscale			1.1
			forecolor			0.5 1 0.1 1
			textalign			ITEM_ALIGN_LEFT
	
			cvar				"ui_saber2"
			
		cvarStrList
			{
				@MENUS_SINGLE_HILT1 	"single_1"
				@MENUS_SINGLE_HILT2 	"single_2"
				@MENUS_SINGLE_HILT3 	"single_3"
				@MENUS_SINGLE_HILT4 	"single_4"
				@MENUS_SINGLE_HILT5 	"single_5"
				@MENUS_SINGLE_HILT6 	"single_6"
				@MENUS_SINGLE_HILT7 	"single_7"
				@MENUS_SINGLE_HILT8 	"single_8"
				@MENUS_SINGLE_HILT9 	"single_9"
				"Inquisitor Single" 	"single_10"
			}
			visible				1	 
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		0 120 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber2_hilt"
			}
		}
			//###################################
			//#		РУКОЯТЬ ДВОЙНОЙ МЕЧ	    	#
			//###################################
	itemDef 
		{
			name				hilt_staff
			text				" "
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1.1
			forecolor			0.5 1 0.1 1
			
			cvar				"ui_saber"
			
			//FIXME: read these from sabers.cfg + *.sab?
			cvarStrList
			{
				@MENUS_STAFF_HILT1 		"staff_1"
				@MENUS_STAFF_HILT2 		"staff_2"
				@MENUS_STAFF_HILT3 		"staff_3"
				@MENUS_STAFF_HILT4 		"staff_4"
				@MENUS_STAFF_HILT5 		"staff_5"
				"Inquisitor Helisaber" 	"staff_6"

			}
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow			0 120 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
			action 
			{
				play			"sound/interface/choose_hilt.wav"
				uiScript  		"saber_hilt"
			}
		}		
			//###################################
			//#			 СТИЛЬ МЕЧА 	  	 	#
			//###################################
//****************
// Текст: Стиль меча
//****************		
	itemDef 
		{
			name				saberstyle_text
			text				@MENUS_SABERSTYLE
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			textalign			ITEM_ALIGN_LEFT
			rect				0 120 120 30
			visible				1
			decoration
		}	
//****************
// Стиль меча: Выбор
//****************
	itemDef 
		{
			name				saberstyle
			text				" "
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			textalign			ITEM_ALIGN_LEFT
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			0.5 1 0.1 1
			rect				120 120 200 30
	
			cvar				"ui_newfightingstyle"
		cvarStrList
			{
				@MENUS_COMBATSTYLEFAST     "0"
				@MENUS_COMBATSTYLEMEDIUM   "1"
				@MENUS_COMBATSTYLEHEAVY    "2"
			}
			visible				1
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow			0 120 320 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			} 
		}
//
//_______________________________________________________________________________________________
//
//							ПЕРВЫЙ ЦВЕТ МЕЧА
//_______________________________________________________________________________________________
//****************
// Титул: Цвет кристала
//****************		
	itemDef 
		{
			name				color_title
			text				@MENUS_BLADE_COLOR
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textalignx			10
			textscale			1.1
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//****************
// Текст: Цвет
//****************		
	itemDef 
		{
			name				color_set_text
			text				@MENUS_COLOR1
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			textalign			ITEM_ALIGN_LEFT
			visible				1
			decoration
		}
//****************
// Цвет Меча (1)
//****************
	itemDef 
		{
			name				colorbut
			text				" "
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			0.5 1 0.1 1
			textalign			ITEM_ALIGN_LEFT
			visible				1
			
			cvar				"ui_saber_color"
		cvarStrList
			{
				"Red" 			"red"
				"Orange" 		"orange"
				"Yellow" 		"yellow"
				"Green" 		"green"
				"Blue" 			"blue"
				"Purple" 		"purple"
			}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		460 40 180 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
		action 
			{
				play			"sound/interface/choose_blade.wav"
				uiScript  		"saber_color"
			}
		}
//****************
// Текст: Цвет
//****************		
	itemDef 
		{
			name				Color_set_text2
			text				@MENUS_COLOR1
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			.95 .64 .37 1
			textalignx			10
			textalign			ITEM_ALIGN_LEFT
			visible				1
			decoration
		}
//****************
// Цвет Меча (2)
//****************
		itemDef 
		{
			name				colorbut2
			text				" "
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textstyle			3
			font				3
			textscale			1.1
			forecolor			0.5 1 0.1 1
			visible				0

			cvar				"ui_saber2_color"
		cvarStrList
			{
				"Red" 		"red"
				"Orange" 	"orange"
				"Yellow" 	"yellow"
				"Green" 	"green"
				"Blue" 		"blue"
				"Purple" 	"purple"
			}
		mouseEnter 
			{ 
				show			sidebutton_glow
				setitemrect		sidebutton_glow		460 60 180 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}  	  
		action 
			{
				play			"sound/interface/choose_blade.wav"
				uiScript  		"saber2_color"
			}
		}	
//
//_______________________________________________________________________________________________
//
//							КНОПКИ В МЕНЮ
//_______________________________________________________________________________________________
//****************
// Кнопка "Назад"
//****************	
	itemDef 
		{
			name				back
			text				@MENUS_BACK_CAPS
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textalign			ITEM_ALIGN_LEFT
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				1
			textalignx 			35
			
			cvarTest			saber_menu
			showCvar			{ "0" }
			
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		0  450 120 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow 
			}	  	  
		action 
			{ 
				play			"sound/interface/esc.wav" 								
				close			all ; 
				open			characterMenu
			}
		}
//****************
// Кнопка "Далее"
//****************	
	itemDef 
		{
			name				next
			text				@MENUS_BEGIN_GAME
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			textalign			ITEM_ALIGN_LEFT
			textalignx			12
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				1	
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		150 450 220 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	
		action 
			{ 

				uiScript 		"updatesabercvars"
				uiScript 		"updatefightingstyle"

				uiScript		startgame	
			}	  	  
		}
//****************
// Кнопка "Продолжить"
//****************	
	itemDef 
		{
			name				continue
			text				@MENUS_CONTINUE
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			rect				210 450 120  32
			textstyle			3
			font				3
			textscale			1
			forecolor			.95 .64 .37 1
			visible				0
			textalignx			10

			cvarTest			saber_menu
			showCvar			{ "1" }

		action 
			{ 
				uiScript 		"updatesabercvars"
				uiScript 		"updatefightingstyle"
				exec			"playermode" "player_2"
				close			all
				setcvar			tier_storyinfo		"13"
				open			ingameGotoTier
				setcvar			storyhead			"kyle"
// HACK We're expecting to go to a mission screen from here
				playvoice		"sound/chars/storyinfo/13.mp3"	
			}
		mouseEnter 
			{ 
				show			sidebutton_glow 
			    setitemrect		sidebutton_glow		150 450 220 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow
			}	  	  
		}
//*********
// Выделение элементов
//*********
	itemDef 
		{
			name				sidebutton_glow
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendbox"
			forecolor			1 1 1 1
			decoration
		}
	}
}