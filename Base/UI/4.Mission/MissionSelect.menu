			rect				445 420 173 30
			text				@MENUS_CONTINUE
			textstyle			3
			font				3
			textscale			1			
			textalignx			37
			textaligny			0
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
			visible				1
			
		cvartest				"tier_storyinfo"
		showcvar
			{
				"1" "2"
			}
		mouseEnter 
			{
				show			glow
				setitemrect		glow	445	420	173	30
			}
		mouseExit 
			{ 
				hide			glow
			}
		action
			{
				hide			victory2
				hide			victorytext
				hide			models
				
				show			story2
				show			story2text
				playvoice		"sound/chars/storyinfo/2.mp3"
