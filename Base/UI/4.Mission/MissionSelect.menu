	itemDef
		{
			name				continue_stats
			group				stats
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				230 400 200 30
			text				@MENUS_CONTINUE
			textstyle			3
			font				3
			textscale			1			
			textalignx			50
			textaligny			0
			
			background			"menu/box_redux"
			forecolor			1 1 1 1
			border				4
		mouseEnter 
			{ 
				show			glow
				setitemrect		glow	230	400	200	30
			}
		mouseExit 
			{ 
				hide			glow
			}
		action
			{
				hide			stats
				hide			glow
				hide			continue_stats
				
				show			galagrama
				show			models
				show			victorytext
				show			victory_comp
				show			background
			}
		}
	}
	
