//_______________________________________________________________________________________________
//
// 								Mission Select 2 Menu
//						Select missions from the 2nd tier.
//_______________________________________________________________________________________________
{					   
	menuDef 
	{
		name					"ingameMissionSelect1"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
		focusColor				1 1 1 1
	
		disablecolor			.5 .5 .5 1
		
		fadeClamp				1.0						// sets the fadeup alpha
		fadeCycle				25						// how often fade happens in milliseconds
		fadeAmount				0.05					// amount to adjust alpha per cycle	
	onOpen 
		{
		stopVoice
		
			show				mission_button
			show				missions
			
			hide				planet_name
			hide				briefing_text
			hide				accbuttons
			hide				planet
			hide				planets_box
			
			setitemcolor		miss1			forecolor	.95 .64 .37 0
			setitemcolor		miss2			forecolor	.95 .64 .37 0
			setitemcolor		miss3			forecolor	.95 .64 .37 0	
			setitemcolor		miss4			forecolor	.95 .64 .37 0
			setitemcolor		miss5			forecolor	.95 .64 .37 0
			setitemcolor		missions		forecolor	.95 .64 .37 0
			
			transition			miss1			180  30 270  0  180  30 270  30 15 15
			transition			miss2			180  65 270  0  180  65 270  30 15 15
			transition			miss3			180 100 270  0  180 100 270  30 15 15
			transition			miss4			180 135 270  0  180 135 270  30 15 15
			transition			miss5			180 170 270  0  180 170 270  30 15 15
			
			fadein				miss1
			fadein				miss2
			fadein				miss3
			fadein				miss4
			fadein				miss5
			fadein				missions
		}	
	onESC 
		{ 
		
		}
//_______________________________________________________________________________________________
//
//	СТРУКТУРА МЕНЮ
//_______________________________________________________________________________________________
//********************
// Фон для меню
//********************
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Затемнения фона
//********************
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}		
//********************
// Выделение элементов
//********************
	itemDef 
		{
			name				sidebutton_glow_red
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendboxr"
			forecolor			1 1 1 1
			decoration
		}
