			//####################################
			//#	Деятельность Наемников - ТАТУИН #
			//####################################	
			
	itemDef
		{
			name				miss1
			group				mission_button
			type				ITEM_TYPE_BUTTON
			text				@MENUS_T1_SOUR_TITLE
			textalign			ITEM_ALIGN_LEFT
			style				WINDOW_STYLE_SHADER
			background			"BoxMenu"
			font				3
			textstyle			3
			textscale			1.1
			textalignx			18
			forecolor			.95 .64 .37 1
			visible				1
			
			
			cvartest			"tiers_complete"
		disablecvar		
			{
				"t1_sour"
			}
			cvarSubString
		mouseEnter 
			{ 
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red		180 30 270 30		
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
			}
		action
			{
			play				"sound/weapons/force/protect.wav" 
			
				setitemtext		planet_name				@MENUS_TATOOINE
				setitemtext		briefing_text 			@BRIEFINGS_T1_SOUR
				
