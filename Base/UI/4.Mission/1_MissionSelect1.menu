				setitemrect		sidebutton_glow_red			350 435 160 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
			}
		action
			{
			playVoice			"sound/chars/luke/06luk001.mp3"
				
				show			luke
				show			next_button		


				setcvar 		tier_mapname 			"maptransition t1_danger"	
				
				show			accept_text
				setitemtext		accept_text 			@T1_DANGER_06LUK001			
				
				hide			briefing_text
				hide 			accbuttons				
				hide			sidebutton_glow_red
				hide			planet
				hide			mission_button
			}
		}

			//####################################
			//#	   Принятие миссии 5: Кнопка	 #
			//####################################
	
	itemDef
		{
			name				accbut5
			group				accbuttons
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				350 435 160 30
			text				@MENUS_ACCEPT
			textstyle			3
			font				3
			textscale			1
			textalign			ITEM_ALIGN_LEFT
			textalignx			47
			background			"BoxMenu"

		mouseEnter 
			{ 
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red			350 435 160 30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
			}
		action
			{
			playVoice			"sound/chars/kyle/05kyk001.mp3"
				
				show			prot
				show			next_button
				
				setcvar 		tier_mapname 			"maptransition t1_rail"
				
				show			accept_text
				setitemtext		accept_text 			@T1_RAIL_05KYK001	

				hide			briefing_text
				hide 			accbuttons				
				hide			sidebutton_glow_red
				hide			planet
				hide			mission_button
			}
		}
