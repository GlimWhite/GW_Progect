//----------------------------------------------------------------------------------------------
// Mission Select Menu
//
//
//----------------------------------------------------------------------------------------------
{			   
	menuDef 
	{
		name					"ingameMissionSelect"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					426
		descScale				1
		descColor				1 .682 0 .8
		descAlignment				ITEM_ALIGN_CENTER	
		disablecolor				.5 .5 .5 1
		fadeClamp				1.0					// sets the fadeup alpha
		fadeCycle				20					// how often fade happens in milliseconds
		fadeAmount				0.1					// amount to adjust alpha per cycle	
		onOpen 
		{
			uiScript			loadmissionselectmenu tier_storyinfo
			
				transition		Box_text		 	5 230 630   0   5 230 630 240 15 15
				transition		decplanet			5 230 630   0   5 230 630 240 15 15
		}							
		onESC 
		{ 
		close all
		}
//_______________________________________________________________________________________________
//
//	СТРУКТУРА МЕНЮ
//_______________________________________________________________________________________________
//********************
// Фон для меню
//********************
	itemDef 
		{
			name				groundmenu
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Затемнения фона
//********************
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}	
//********************
// Выделение элементов
//********************
	itemDef 
		{
			name				sidebutton_glow_red
			group				none
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_blendboxr"
			forecolor			1 1 1 1
			decoration
		}
//***********************
//*	  Диталь к фону		*
//***********************
	itemDef 
		{
			name				decplanet
			group				none
			style				WINDOW_STYLE_SHADER
			background			"mission_dec3"
			forecolor			0.2 0.1 0.8 1
			visible				0
			decoration
		}
//***********************
//*	 	Фон для текста	*
//***********************		
	itemDef 
		{
			name				Box_text
			textstyle			WINDOW_STYLE_SHADER	
			background			"box_blue"
			forecolor			0.2 0.1 0.8 1
			border				1
			bordersize			2
			bordercolor			1 .2 .2 0.5
			visible				1
			decoration
		}
		
	itemDef
		{
			name				complete
			type				ITEM_TYPE_TEXT
			rect				170 16 300 32
			text				@MENUS_MISSION_COMPLETE
			font				3
			textstyle			3
			forecolor			.549 .854 1 1
			textscale			1
			textalign			ITEM_ALIGN_CENTER
			textalignx			150
			textaligny			-1
			visible				1
			decoration
		}
//_______________________________________________________________________________________________
