//_______________________________________________________________________________________________
//
//								IN GAME MISSION SELECT/ МЕНЮ ПОСЛЕ ПРОХОЖДЕНИЕ
//_______________________________________________________________________________________________
{			   
	menuDef 
	{
		name					"ingameMissionSelect"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					426
		descScale				1
		descColor				1 .682 0 .8
		descAlignment			ITEM_ALIGN_CENTER	
		disablecolor			.5 .5 .5 1
		fadeClamp				1.0					// sets the fadeup alpha
		fadeCycle				20					// how often fade happens in milliseconds
		fadeAmount				0.1					// amount to adjust alpha per cycle	
	onOpen 
		{
			uiScript			loadmissionselectmenu tier_storyinfo
			
			hide				models
			show				stats
				
			hide				galagrama
		}							
	onESC 
		{ 
			close				all
		}
//_______________________________________________________________________________________________
//
//	СТРУКТУРА МЕНЮ
//_______________________________________________________________________________________________
//********************
// Фон для меню
//********************
	itemDef 
		{
			name				blackground
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"GroundMenu"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Затемнения фона
//********************
	itemDef 
		{
			name				black_ground
			rect				0 0 640 480
			style 				WINDOW_STYLE_FILLED
			backcolor			0 0 0 0.5
			forecolor			0 0 0 0.5
			visible				1
			decoration
		}
//********************
// Выделение элементов
//********************		
	itemDef 
		{
			name				complete_glow
			group				none
			rect				170 -4 300 32
			style				WINDOW_STYLE_SHADER
			background			"menu/menu_buttonback"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
//********************
// Текст: "Миссия выполнена"
//********************	
	itemDef
		{
			name				complete
			type				ITEM_TYPE_TEXT
			rect				170 -2 300 32
			text				@MENUS_MISSION_COMPLETE
			font				3
			textstyle			3
			forecolor			.95 .64 .37 1
			textscale			1.1
			textalign			ITEM_ALIGN_CENTER
			textalignx			150
			textaligny			-1
			visible				1
			decoration
		}	
//_______________________________________________________________________________________________

		//###################################
		//#		  КНОПКА "ПРОДОЛЖИТЬ		#
		//###################################
		
	itemDef
		{
			name				continue_stats
			group				stats
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			rect				230 400 200 30
			text				@MENUS_CONTINUE
			textstyle			3
			font				3
			textscale			1.1			
			textalignx			50
			textaligny			0
			
			background			"BoxMenu"
			forecolor			1 1 1 1
			border				4
		mouseEnter 
			{ 
				show			glow
				setitemrect		glow	230	400	200	30
			}
		mouseExit 
			{ 
				hide			glow
			}
		action
			{
				Open			victorymassagemenu
			}
		}		
