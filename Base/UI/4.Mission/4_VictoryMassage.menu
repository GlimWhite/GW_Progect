//_______________________________________________________________________________________________
//
// 						SUBTITLES FOR TIER VICTORY MESSAGES
//_______________________________________________________________________________________________
{					   
	menuDef 
	{
		name					"victorymassagemenu"
		fullScreen				1		
		rect					0 0 640 480	
		visible					1
		focusColor				1 1 1 1
	
		disablecolor			.5 .5 .5 1
		
		fadeClamp				1.0						// sets the fadeup alpha
		fadeCycle				25						// how often fade happens in milliseconds
		fadeAmount				0.05					// amount to adjust alpha per cycle	
	onOpen 
		{
		uiScript				loadmissionselectmenu 	tier_storyinfo
		//	show				victory_text
		show					victory_comp
		//show					models2
		
				transition		planets_box			 	5 230 630   0   5 230 630 240 15 15
				transition		decplanet			  	5 230 630   0   5 230 630 240 15 15
				
				hide			story_text
		}	
		
	onESC 
		{ 
		
		}
