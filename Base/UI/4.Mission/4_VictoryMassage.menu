			forecolor			1 1 1 1
			cvartest			"tier_storyinfo"
		showcvar
			{
				"1" "2" "4"
			}
			visible				0
		mouseEnter 
			{
				show			sidebutton_glow_red
				setitemrect		sidebutton_glow_red		445	380	173	30
			}
		mouseExit 
			{ 
				hide			sidebutton_glow_red
			}
		action
			{
				close			all
				open			ingameMissionSelect1
			}
		}
		
