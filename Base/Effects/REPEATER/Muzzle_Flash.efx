// Simple muzzle flash effect

Line
{
	life		10
	origin2		-5 0 0 	0 0 0
	
	width
	{
		start 	8 	14
		end		5.0
		flags	linear
	}

	alpha
	{
		start	0.5	0.6
		end		0.35
		flags	linear
	}

	shader
		[
			repeaterSideFlash
		]
}

Particle
{
	life		30
	origin		-5 0 0
	rotation	0	360	
	size
		{
			start 	5	10
			end		3.0
			flags	linear
		}
	alpha
		{
			start	0.8	1.0
			end		0.6
			flags	linear
		}
	shader
		[
			repeaterfrontflash
		]
}

Particle
{
	flags				useAlpha

	count				10

	life				30

	origin				-5 0 0

	rotation			-180 180

	rotationDelta		-4 4

	velocity			10 -2 -2 20 2 2

	gravity				5 35

	rgb
	{
		start  1.0 0.7 0.2
	}
	
	alpha
	{
		start			0.5 0.7
		end				0.2
		parm			50
		flags			nonlinear
	}

	size
	{
		start			1.5 2
		end				3 4
		flags			linear
	}

	shaders
	[
		spark
	]
}

Light
{
	size
	{
		start 	100	150
	}

	rgb
	{
		start  1.0 0.7 0.2
	}
}

Sound
{
	sounds
	[
		sound/weapons/repeater/fire.wav
	]
}

forcefeedback
{
	forces
	[
		fffx/weapons/repeater/fire
	]
}


CameraShake
{
	life				50

	intensity			0.3 0.4

	radius				60
}