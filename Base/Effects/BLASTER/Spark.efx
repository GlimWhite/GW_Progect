//#######################################
//#		Попадание по стенам Эффект		#
//#######################################
Cylinder
{
	name					"Круг от атаки"
	
	life					250
	
	rgb
		{
			start			1 0.5 0.5 1 0.1 0.1 
			end				1 0 0
		}
	alpha
		{
			start			1
			end				0
			flags			linear
		}

	size
		{
			start			0
			end				10
			flags			linear
		}
	shaders
		[
			DisruptorShockWave
		]
}
//#######################################
//#		Эффекты искр после выстрела		#
//#######################################
Particle
{
		name				spark
		
		flags				usePhysics	rgbComponentInterpolation
		
		spawnFlags			axisFromSphere
		
		count				30 50

		life				1000 1300

		bounce				0.2
		
		cullrange			800
		
		velocity			45 -180 -180 245 180 180

		gravity				-350 -450
	rgb
		{
			start			1 0.5 0 
			end				1 0.05 0.05
			flags			linear
		}
	alpha
		{
			start			1.0
			end 			0.0
			parm			60 	75
			flags			nonlinear
		}
	size
		{
			start			1
			end 			0.1
			flags			linear
		}
	shaders
		[
			sparkglow
		]
}

