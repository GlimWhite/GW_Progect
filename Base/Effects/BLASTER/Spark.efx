//#######################################
//#		Эффекты искр после выстрела		#
//#######################################
Tail
{
		count				30
			
		life				800

		velocity			0 180 180 180 -180 -180

		gravity				-300 -400

	rgb
		{
			start			1 1 0.5
		}
	size
		{
			start			1
			end				0
			flags			linear
		}
	length
		{
			start			10
			parm			70
			flags			linear nonlinear
		}
	shaders
		[
			sparkglow
		]
}
