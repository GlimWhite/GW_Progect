// Smoke bolton effect when you hit a ghoul2 model--note this is not an efficient way to do this.

Particle
{
	count	3 4
	life	800	1200

	// this is really NOT a good thing to be doing because it has the potential to choke up the scheduler

	rotation	0	360

	origin		-5 0 -1
	vel			25 0 0	30 0 0
	accel		-5 -30 -30	50 0 0
	gravity		50	200
	flags		usealpha

	size
	{
		start 	18.0	24.0
		end		0
		flags	linear
	}

	alpha
	{
		start	1	0.8
		end 	0.0
		flags	linear
	}

	shader
	[
		gfx/misc/steam
	]
}
