//Эффект от отражение атаки
Tail
{
	count	15
	life	400
	spawnflags 	orgOnSphere 	axisFromSphere

	radius		25
	vel			150 50 100			-150 -50 100
	size
		{
			start	0.1 0.8
			end		1	0
			flags	random
		}
	length
		{
			start	1
			end		1 5
			flags 	random
		}
	alpha
		{
			start	1.0
			end		0.0
			parms	160
			flags 	nonlinear
		}

	shader
		[
			gfx/effects/sabers/orange_glow
			gfx/effects/sabers/yellow_glow
		]
}
