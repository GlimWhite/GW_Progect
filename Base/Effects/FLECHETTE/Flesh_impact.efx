// Simple flechette impact effect

// Mini-explosion made out of a couple of lines
Line
{
	count 	6	10
	life	100	200

	origin2	12 -10 -10		18 10 10

	width
	{
		start 	0.5 	1.0
	}

	alpha
	{
		start 	0.25 	1.0
		end	0.0
		flags	linear
	}
	
	shader
	[
		gfx/misc/spark
		gfx/misc/spark2
	]
}

// Let's call another existing effect to get some smoke!
Particle
{
	count		10
	
	life		550

	rotation	0	360

	origin		-5 0 -1
	
	velocity	0 0 0 150 0 0
	
	gravity		50	120

	size
	{
		start 	1
		end		17.0	19.0
		flags	linear
	}

	alpha
	{
		start	0.4
		end 	0.0
		flags	linear
	}

	shader
	[
		gfx/misc/steam
	]
}

Decal
{
	count	10

	size
		{
			start 	5.5	7.0
		}

		shader
		[
			flechettemark
		]
}

Sound
{
	sounds
	[
		sound/weapons/flechette/ricochet2.wav
	]
}
