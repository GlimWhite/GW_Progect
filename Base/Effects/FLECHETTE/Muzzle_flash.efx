// Simple muzzle flash effect

Line
{
	life		30
	origin2		12 0 0 	22 0 0

	width
		{
			start 	16.2 	18.5
			end		5.0
			flags	linear
		}
	alpha
		{
			start	0.5	0.6
			end	0.35
			flags	linear
		}
	size
		{
			start	20
			end		5
			flags	wave
		}
	shader
		[
			flechettefront
		]
}

Particle
{
	life		75
	
	origin		0 0 0
	

	size
	{
		start 	10.0 	16.5
		end		7.0
		flags	linear
	}

	alpha
	{
		start	0.8	1.0
		end	0.7
		flags	linear
	}

	shader
	[
		flechettefront
	]
}

// throw off some smoke
Particle
{
	count			10	12
	life			350	700

	origin			6 -1 -1		10 1 1

	rotation		-180 180
	rotationdelta	-20 20

	velocity		40 -15 -15		80 15 15
	gravity			0	10

	size
	{
		start 		1.0 3.0
		end			4.0	8.0
		flags		linear
	}

	alpha
	{
		start		0.5	0.7
		end 		0.0
		flags		linear
	}

	shader
	[
		gfx/misc/steam
	]
}

Tail
{
	count		60	100
	life		150	325

	origin		-2 -1 -1			-4 1 1
	vel			140 -68 -68		250 68 68
	accel		-10 -20 -20		10 20 20
	
	size
	{
		start 	0.6	1.1
		end		0.0
		parm	60	70
		flags	nonlinear linear
	}

	rgb
	{
		start	1.0 0.6 0.0		1.0 1.0 0.1
		end		1.0 0.4 0.0
		flags	linear
	}

	length
	{
		start 7.0	18.0
		end 	2.0	5.0
		flags linear
	}

	shader
	[
		flechetteside
		sparkglow
	]
}

Light
{
	size
	{
		start 	100	150
	}

	rgb
	{
		start  1.0 0.7 0.2
	}
}


sound
{
	sounds
	[
		sound/weapons/flechette/fire.wav
	]
}

forcefeedback
{
	forces
	[
		fffx/weapons/flechette/fire
	]
}

CameraShake
{
	life				100

	intensity			0.8 0.9

	radius				60
}