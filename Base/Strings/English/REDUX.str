// Примечание для переводчиков:
// Если предложение такое же на вашем языке, измените его на «#same»
//
//например:
// LANG_ENGLISH "ОСТАНОВКА"
// LANG_GERMAN "#тот же"
//
// (Это делается для того, чтобы мы могли определить, какие строки были подписаны как допустимые, чтобы быть одними и теми же словами для QA
// и потому что мы не храним повторяющиеся строки, которые в следующий раз будут снова экспортированы
// как непереведенное.)
//
//REFERENCE		MOUSE_JOYSTICK 				//ССЫЛКА		НАИМЕНОВАНИЕ
//NOTES			"Setup / Control button"	//ПРИМЕЧАНИЯ 	"ССЫЛКА НА ТЕКСТ"
//LANG_ENGLISH  "CONTROL"					//ЯЗЫК			"СЛОВА"
//LANG_FRENCH	""							//ЯЗЫК2			"СЛОВА"
//
VERSION             "1"
CONFIG              ""
FILENOTES           ""

REFERENCE           KEYBOARD
LANG_ENGLISH        "KEYBOARD"

ENDMARKER